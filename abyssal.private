-- СКРИПТ ОБЪЕДИНЕННЫЙ
-- Берет интерфейс и большинство функций из Absolute
-- Добавляет функции из Posral: GrabTarget, PalletForRagdoll, AntiBurn, ViewPCLD
-- Убирает старые Ownership Kick и Pallet Ragdoll из Absolute

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Absolute_Startup"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

function StartMainScript(titleText)
    local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/fleksmi-bot/Library2/refs/heads/main/Library1.lua"))()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer
    local RS = ReplicatedStorage
    local TweenService = game:GetService("TweenService")

    local Window = Library:CreateWindow({
        Title = titleText,
        Theme = "Night",
        ShowWatermark = { Enabled = true, Title = true, User = false, FPS = true, Duration = false, Ping = true, Time= false },
        ToggleKey = Enum.KeyCode.RightShift,
    })

    local mainGui = Window.Parent
    if mainGui then
        local bgFlag = Instance.new("Frame")
        bgFlag.Size = UDim2.new(1, 0, 1, 0)
        bgFlag.BackgroundTransparency = 1
        bgFlag.Parent = mainGui

        local s1 = Instance.new("Frame")
        s1.Size = UDim2.new(1, 0, 0.33, 0)
        s1.Position = UDim2.new(0, 0, 0, 0)
        s1.BackgroundColor3 = Color3.fromRGB(255, 182, 193)
        s1.BackgroundTransparency = 0.15
        s1.BorderSizePixel = 0
        s1.Parent = bgFlag

        local s2 = Instance.new("Frame")
        s2.Size = UDim2.new(1, 0, 0.33, 0)
        s2.Position = UDim2.new(0, 0, 0.33, 0)
        s2.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        s2.BackgroundTransparency = 0.15
        s2.BorderSizePixel = 0
        s2.Parent = bgFlag

        local s3 = Instance.new("Frame")
        s3.Size = UDim2.new(1, 0, 0.34, 0)
        s3.Position = UDim2.new(0, 0, 0.66, 0)
        s3.BackgroundColor3 = Color3.fromRGB(182, 102, 210)
        s3.BackgroundTransparency = 0.15
        s3.BorderSizePixel = 0
        s3.Parent = bgFlag

        bgFlag:MoveToBeginning()

        local function recolor(obj)
            if obj:IsA("TextButton") then
                obj.BackgroundColor3 = (math.random(0,1) == 0) and Color3.fromRGB(255,105,180) or Color3.fromRGB(138,43,226)
                obj.TextColor3 = Color3.fromRGB(255,255,255)
                obj.BorderSizePixel = 1
                obj.BorderColor3 = Color3.fromRGB(255,255,255)
            elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                if obj.BackgroundTransparency < 0.5 then
                    obj.BackgroundTransparency = 0.4
                end
            end
            for _, child in pairs(obj:GetChildren()) do
                recolor(child)
            end
        end
        recolor(Window)
    end

    local MainTab = Window:CreateTab("Main", true)
    local DefenseTab = Window:CreateTab("Defense", true)
    local VisualTab = Window:CreateTab("Visual", true)
    local BlodmanTab = Window:CreateTab("Blodman", true)
    local TargetTab = Window:CreateTab("Target", true)

    -- ============================================
    -- БЛОКИ ИЗ ABSOLUTE (СОХРАНЯЕМ)
    -- ============================================
    local KickBlock = MainTab:CreateBlock({Name = "Ownership Kick (Posral)", Side = "Left"})
    local TargetBlock = MainTab:CreateBlock({Name = "Target", Side = "Left"})
    local SettingsBlock = MainTab:CreateBlock({Name = "Settings", Side = "Left"})
    
    local AntiGrabBlock = DefenseTab:CreateBlock({Name = "Anti-Grab", Side = "Left"})
    local AntiKickBlock = DefenseTab:CreateBlock({Name = "Anti-Kick [Shuriken]", Side = "Left"})
    local AntiExplosionBlock = DefenseTab:CreateBlock({Name = "Anti-Explosion", Side = "Right"})
    local AntiSnowBlock = DefenseTab:CreateBlock({Name = "Infinite Ragdoll", Side = "Right"})
    local AntiLagBlock = DefenseTab:CreateBlock({Name = "Anti-Lag", Side = "Left"})
    local AntiInputLagBlock = DefenseTab:CreateBlock({Name = "Anti-Input Lag", Side = "Left"})
    local AntiBurnBlock = DefenseTab:CreateBlock({Name = "Anti Burn", Side = "Right"})
    local VisualBlock = VisualTab:CreateBlock({Name = "Visual Settings", Side = "Left"})
    
    local BlodmanMainBlock = BlodmanTab:CreateBlock({Name = "BLODMAN KICK", Side = "Left"})
    local BlodmanSettingsBlock = BlodmanTab:CreateBlock({Name = "Settings", Side = "Right"})
    local BlodmanV2Block = BlodmanTab:CreateBlock({Name = "BLODMAN KICK v2", Side = "Left"})
    local BlodmanV2SettingsBlock = BlodmanTab:CreateBlock({Name = "Settings v2", Side = "Right"})
    local BlodmanAutoSitBlock = BlodmanTab:CreateBlock({Name = "Auto Sit Blodman", Side = "Left"})

    -- ============================================
    -- НОВЫЕ БЛОКИ ИЗ POSRAL
    -- ============================================
    local PosralTargetBlock = TargetTab:CreateBlock({Name = "Grab Target (Posral)", Side = "Left"})
    local PosralSettingsBlock = TargetTab:CreateBlock({Name = "Settings (Posral)", Side = "Right"})
    local ViewPCLDBlock = VisualTab:CreateBlock({Name = "View PCLD", Side = "Right"})

    -- ============================================
    -- ПОМОЩНИКИ
    -- ============================================
    local function getname(v)
        if type(v) ~= "string" then return "" end
        return v:split(" ")[2]:split("(")[2]:split(")")[1]
    end

    local function stvel(hrp)
        if not hrp then return end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    local function sno(part)
        pcall(function()
            local grabEvents = RS:FindFirstChild("GrabEvents")
            local setNetOwner = grabEvents and grabEvents:FindFirstChild("SetNetworkOwner")
            if setNetOwner and part then
                setNetOwner:FireServer(part, part.CFrame)
            end
        end)
    end

    local function gblob()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum and hum.SeatPart and hum.SeatPart.Parent and hum.SeatPart.Parent.Name == "CreatureBlobman" then
            return hum.SeatPart.Parent
        end
        return nil
    end

    local function spawntoy(toy, cf)
        local spawnRemote = RS:FindFirstChild("MenuToys") and RS.MenuToys:FindFirstChild("SpawnToyRemoteFunction")
        if not spawnRemote then return nil end
        
        local inv = Workspace:FindFirstChild(LocalPlayer.Name.."SpawnedInToys")
        if not inv then return nil end
        
        local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
        if canSpawn and not canSpawn.Value then
            canSpawn.Changed:Wait()
        end
        
        local spawned
        local conn = inv.ChildAdded:Connect(function(c)
            if c.Name == toy then spawned = c end
        end)
        
        task.spawn(function()
            pcall(function()
                spawnRemote:InvokeServer(toy, cf, Vector3.zero)
            end)
        end)
        
        local start = tick()
        repeat task.wait() until spawned or tick() - start > 3
        conn:Disconnect()
        return spawned
    end

    local function DestroyToy(toy)
        local destroyToy = RS:FindFirstChild("MenuToys") and RS.MenuToys:FindFirstChild("DestroyToy")
        if destroyToy and toy then
            pcall(function() destroyToy:FireServer(toy) end)
        end
    end

    -- ============================================
    -- СПИСОК ИГРОКОВ ДЛЯ ДРОПДАУНОВ
    -- ============================================
    local targetNames = {}
    local function updateList()
        targetNames = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local displayName = p.DisplayName or p.Name
                table.insert(targetNames, displayName .. " (" .. p.Name .. ")")
            end
        end
    end

    local function getPlayerFromSelection(selection)
        if not selection or selection == "" then return nil end
        local username = selection:match("%((.-)%)")
        if username then
            return Players:FindFirstChild(username)
        end
        return nil
    end

    -- ============================================
    -- GRAB TARGET ИЗ POSRAL
    -- ============================================
    local PosralTargetSettings = {
        Name = nil,
        Char = nil,
        HRP = nil,
        Method = nil,
        OffsetX = 0,
        OffsetY = 15,
        OffsetZ = 0,
    }
    local applyMethodActive = false
    local applyMethodTask = nil
    local PalletForRagdoll = nil
    local offset = CFrame.new(0, 15, 0)

    -- Создаем элементы для Posral Target
    local PosralTargetDropdown = PosralTargetBlock:CreateDropdown({
        Name = "Select Target",
        Options = targetNames,
        Callback = function(v)
            PosralTargetSettings.Name = getname(v)
        end
    })

    PosralTargetBlock:CreateButton({
        Name = "Refresh List",
        Callback = function()
            updateList()
            PosralTargetDropdown:Refresh(targetNames, true)
        end
    })

    PosralTargetBlock:CreateDropdown({
        Name = "Method",
        Options = {"Loop Grab(Kick)", "Loop Grab", "Kill"},
        Default = 0,
        Callback = function(v)
            PosralTargetSettings.Method = v
        end
    })

    -- Функция Pallet Ragdoll из Posral
    local function SpawnPalletRagdoll()
        if PalletForRagdoll and PalletForRagdoll.Parent then return end
        
        local pallet = spawntoy("PalletLightBrown", LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and 
            LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 10, 20) or CFrame.new(0, 100, 0))
        if not pallet then return end
        
        local soundPart = pallet:FindFirstChild("SoundPart")
        if not soundPart then return end
        
        repeat task.wait() sno(soundPart) until soundPart:FindFirstChild("PartOwner")
        soundPart.AssemblyLinearVelocity = Vector3.new(0, 1e9, 0)
        
        for _,v in pairs(pallet:GetChildren()) do
            if v:IsA("Part") then
                v.CanCollide = false
                v.CanQuery = false
                v.Transparency = 1
            end
        end
        
        pallet.Name = "PalletForRagdoll"
        PalletForRagdoll = pallet
        
        -- Следим за удалением
        if PalletForRagdoll then
            PalletForRagdoll.Destroying:Once(function()
                if applyMethodActive then
                    task.wait(0.5)
                    SpawnPalletRagdoll()
                end
            end)
        end
    end

    -- Основная функция Apply Method из Posral
    local function ApplyMethodLoop()
        while applyMethodActive do
            local tt = PosralTargetSettings.Name and Players:FindFirstChild(PosralTargetSettings.Name)
            if not tt then task.wait(0.1) continue end
            
            local Method = PosralTargetSettings.Method
            if not Method then task.wait(0.1) continue end
            
            local char = LocalPlayer.Character
            local HRP = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if not HRP or not hum then task.wait(0.1) continue end
            
            local tChar = tt.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")
            if not tRoot or not tHum or tHum.Health <= 0 then task.wait(0.1) continue end
            
            local pos = HRP.CFrame
            local offsetCF = CFrame.new(PosralTargetSettings.OffsetX or 0, PosralTargetSettings.OffsetY or 15, PosralTargetSettings.OffsetZ or 0)
            
            if Method == "Loop Grab(Kick)" then
                -- Проверяем, сидит ли игрок на блобмане
                if tChar.Parent ~= workspace then
                    local blob = gblob() or spawntoy("CreatureBlobman", HRP.CFrame * CFrame.new(5, 5, 20))
                    if blob then
                        blob.Name = "cringe"
                        local seat = blob:FindFirstChildWhichIsA("VehicleSeat")
                        if seat then
                            seat:Sit(hum)
                            repeat task.wait() until hum.SeatPart == seat
                            
                            local remoteFolder = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                            if remoteFolder then
                                local CG = remoteFolder:FindFirstChild("CreatureGrab")
                                local CD = remoteFolder:FindFirstChild("CreatureRelease")
                                if CG and CD then
                                    blob.HumanoidRootPart.CFrame = tRoot.CFrame
                                    task.wait(0.2)
                                    repeat
                                        task.wait()
                                        CG:FireServer(blob.RightDetector, tRoot, blob.RightDetector.RightWeld)
                                        CD:FireServer(blob.RightDetector.RightWeld)
                                    until tRoot:FindFirstChild("PartOwner")
                                    task.wait(0.2)
                                    tRoot.CFrame = pos * offsetCF
                                    HRP.CFrame = pos
                                    DestroyToy(blob)
                                    task.wait(0.5)
                                end
                            end
                        end
                    end
                end
                
                if tRoot and hum and HRP then
                    -- Kick via DestroyGrabLine
                    pcall(function()
                        local grabEvents = RS:FindFirstChild("GrabEvents")
                        local destroyLine = grabEvents and grabEvents:FindFirstChild("DestroyGrabLine")
                        local setNetOwner = grabEvents and grabEvents:FindFirstChild("SetNetworkOwner")
                        
                        if destroyLine and setNetOwner then
                            destroyLine:FireServer(tRoot)
                            RunService.RenderStepped:Wait()
                            setNetOwner:FireServer(tRoot, tRoot.CFrame)
                            destroyLine:FireServer(tRoot)
                            RunService.RenderStepped:Wait()
                            setNetOwner:FireServer(tRoot, tRoot.CFrame)
                            destroyLine:FireServer(tRoot)
                            RunService.RenderStepped:Wait()
                            setNetOwner:FireServer(tRoot, tRoot.CFrame)
                            destroyLine:FireServer(tRoot)
                        end
                    end)
                    
                    if (tRoot.Position - HRP.Position).Magnitude >= 29 and tChar.Parent == workspace then
                        task.wait(0.1)
                        HRP.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        task.wait(0.2)
                        sno(tRoot)
                        task.wait()
                        HRP.CFrame = pos
                        task.wait(0.2)
                        for _,v in pairs(tChar:GetChildren()) do
                            if v:IsA("BasePart") and v.Name ~= "Humanoid" then
                                v.CFrame = pos * offsetCF
                            end
                        end
                    end
                    
                    if tRoot.Position.Y < HRP.Position.Y + 4 and tChar.Parent == workspace then
                        repeat task.wait() sno(tRoot) until tChar.Head and tChar.Head:FindFirstChild("PartOwner")
                        HRP.CFrame = pos
                        tRoot.CFrame = HRP.CFrame * offsetCF
                    end
                    
                    -- Использование PalletForRagdoll
                    if PalletForRagdoll and PalletForRagdoll:FindFirstChild("SoundPart") then
                        PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
                        PalletForRagdoll.SoundPart.CFrame = tRoot.CFrame
                        task.wait(0.05)
                        PalletForRagdoll.SoundPart.CFrame = HRP.CFrame * CFrame.new(0, 1000, 0)
                    end
                    
                    -- BodyPosition для удержания
                    local bp = tRoot:FindFirstChild("BodyPosition")
                    if not bp then
                        bp = Instance.new("BodyPosition")
                        bp.Parent = tRoot
                        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bp.D = 200
                    end
                    bp.Position = HRP.Position + Vector3.new(offsetCF.X, offsetCF.Y, offsetCF.Z)
                    
                    stvel(tRoot)
                    for _,v in pairs(tChar:GetChildren()) do
                        if HasProperty(v, "AssemblyLinearVelocity") then
                            stvel(v)
                        end
                    end
                end
                
            elseif Method == "Loop Grab" then
                if tRoot and hum and HRP and tChar.Parent == workspace then
                    if (tRoot.Position - HRP.Position).Magnitude > 30 then
                        stvel(HRP)
                        HRP.CFrame = tRoot.CFrame * CFrame.new(0, 0, 5)
                        task.wait()
                        repeat task.wait() sno(tRoot) until tChar.Head and tChar.Head:FindFirstChild("PartOwner")
                        HRP.CFrame = pos
                        tRoot.CFrame = HRP.CFrame * offsetCF
                    end
                    
                    if PalletForRagdoll and PalletForRagdoll:FindFirstChild("SoundPart") then
                        PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
                        PalletForRagdoll.SoundPart.CFrame = tRoot.CFrame
                        task.wait(0.05)
                        PalletForRagdoll.SoundPart.CFrame = HRP.CFrame * CFrame.new(0, 1000, 0)
                    end
                    
                    if tChar.Head and tChar.Head:FindFirstChild("PartOwner") then
                        tRoot.CFrame = HRP.CFrame * offsetCF
                    end
                    sno(tRoot)
                end
                
            elseif Method == "Kill" then
                if tChar.Parent ~= workspace then
                    local blob = gblob() or spawntoy("CreatureBlobman", HRP.CFrame * CFrame.new(5, 5, 20))
                    if blob then
                        blob.Name = "cringe"
                        local seat = blob:FindFirstChildWhichIsA("VehicleSeat")
                        if seat then
                            seat:Sit(hum)
                            repeat task.wait() until hum.SeatPart == seat
                            
                            local remoteFolder = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                            if remoteFolder then
                                local CG = remoteFolder:FindFirstChild("CreatureGrab")
                                local CD = remoteFolder:FindFirstChild("CreatureRelease")
                                if CG and CD then
                                    blob.HumanoidRootPart.CFrame = tRoot.CFrame
                                    task.wait(0.2)
                                    repeat
                                        task.wait()
                                        CG:FireServer(blob.RightDetector, tRoot, blob.RightDetector.RightWeld)
                                        CD:FireServer(blob.RightDetector.RightWeld)
                                    until tRoot:FindFirstChild("PartOwner")
                                    task.wait(0.2)
                                    tRoot.CFrame = pos * offsetCF
                                    HRP.CFrame = pos
                                    DestroyToy(blob)
                                    task.wait(0.5)
                                end
                            end
                        end
                    end
                end
                
                if tRoot and hum and HRP and tChar.Parent == workspace and tHum.Health > 0 then
                    local pos2 = HRP.CFrame
                    HRP.CFrame = tRoot.CFrame
                    repeat task.wait()
                        sno(tRoot)
                    until tChar.Head and tChar.Head:FindFirstChild("PartOwner")
                    tHum:ChangeState("Dead")
                    pcall(function()
                        local grabEvents = RS:FindFirstChild("GrabEvents")
                        local destroyLine = grabEvents and grabEvents:FindFirstChild("DestroyGrabLine")
                        if destroyLine then destroyLine:FireServer(tRoot) end
                    end)
                    HRP.CFrame = pos2
                end
            end
            
            task.wait(0.05)
        end
    end

    -- Toggle для Apply Method
    PosralTargetBlock:CreateToggle({
        Name = "Apply Method",
        Default = false,
        Callback = function(Value)
            applyMethodActive = Value
            if applyMethodTask then task.cancel(applyMethodTask) end
            if Value then
                if not PosralTargetSettings.Name then
                    Library:Notify({ Title = "Error", Content = "Select target first", Duration = 3 })
                    return
                end
                -- Создаем PalletForRagdoll
                SpawnPalletRagdoll()
                applyMethodTask = task.spawn(ApplyMethodLoop)
                Library:Notify({ Title = "Apply Method", Content = "Enabled", Duration = 2 })
            else
                -- Убираем BodyPosition
                local tt = PosralTargetSettings.Name and Players:FindFirstChild(PosralTargetSettings.Name)
                if tt and tt.Character then
                    local tRoot = tt.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot then
                        local bp = tRoot:FindFirstChild("BodyPosition")
                        if bp then bp:Destroy() end
                    end
                end
                Library:Notify({ Title = "Apply Method", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- Настройки Posral
    local x,y,z = 0,15,0
    PosralSettingsBlock:CreateSlider({
        Name = "Offset X",
        Min = -20,
        Max = 20,
        Default = 0,
        Rounding = 1,
        Callback = function(v)
            x = v
            PosralTargetSettings.OffsetX = v
            offset = CFrame.new(x or 0, y or 15, z or 0)
        end
    })
    PosralSettingsBlock:CreateSlider({
        Name = "Offset Y",
        Min = -20,
        Max = 20,
        Default = 15,
        Rounding = 1,
        Callback = function(v)
            y = v
            PosralTargetSettings.OffsetY = v
            offset = CFrame.new(x or 0, y or 15, z or 0)
        end
    })
    PosralSettingsBlock:CreateSlider({
        Name = "Offset Z",
        Min = -20,
        Max = 20,
        Default = 0,
        Rounding = 1,
        Callback = function(v)
            z = v
            PosralTargetSettings.OffsetZ = v
            offset = CFrame.new(x or 0, y or 15, z or 0)
        end
    })

    PosralSettingsBlock:CreateToggle({
        Name = "Enable Ragdoll Pallet",
        Default = false,
        Callback = function(Value)
            if Value then
                SpawnPalletRagdoll()
                Library:Notify({ Title = "Ragdoll Pallet", Content = "Enabled", Duration = 2 })
            else
                if PalletForRagdoll and PalletForRagdoll.Parent then
                    DestroyToy(PalletForRagdoll)
                end
                PalletForRagdoll = nil
                Library:Notify({ Title = "Ragdoll Pallet", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- ANTI BURN ИЗ POSRAL
    -- ============================================
    local antiburn = nil
    local antiburn1 = nil
    
    AntiBurnBlock:CreateToggle({
        Name = "Anti Burn",
        Default = false,
        Callback = function(Value)
            if Value then
                antiburn1 = LocalPlayer.CharacterAdded:Connect(function(ch)
                    if antiburn then antiburn:Disconnect() end
                    local hum = ch:WaitForChild("Humanoid", 0.5)
                    antiburn = hum.FireDebounce.Changed:Connect(function()
                        if hum.FireDebounce.Value == true then
                            local bar = workspace.Plots.Plot1.Barrier.PlotBarrier
                            local pos = bar.CFrame
                            local hrp = ch:FindFirstChild("HumanoidRootPart")
                            task.spawn(function()
                                repeat task.wait() 
                                    if hrp then bar.CFrame = hrp.CFrame end
                                until not hum.FireDebounce.Value or not Value
                            end)
                            task.wait(1)
                            hum.FireDebounce.Value = false
                            task.wait()
                            bar.CFrame = pos
                        end
                    end)
                end)
                
                local ch = LocalPlayer.Character
                if ch then
                    local hum = ch:FindFirstChild("Humanoid")
                    if hum then
                        antiburn = hum.FireDebounce.Changed:Connect(function()
                            if hum.FireDebounce.Value == true then
                                local bar = workspace.Plots.Plot1.Barrier.PlotBarrier
                                local pos = bar.CFrame
                                local hrp = ch:FindFirstChild("HumanoidRootPart")
                                task.spawn(function()
                                    repeat task.wait() 
                                        if hrp then bar.CFrame = hrp.CFrame end
                                    until not hum.FireDebounce.Value or not Value
                                end)
                                task.wait(1)
                                hum.FireDebounce.Value = false
                                task.wait()
                                bar.CFrame = pos
                            end
                        end)
                    end
                end
                Library:Notify({ Title = "Anti Burn", Content = "Enabled", Duration = 2 })
            else
                if antiburn then antiburn:Disconnect() antiburn = nil end
                if antiburn1 then antiburn1:Disconnect() antiburn1 = nil end
                Library:Notify({ Title = "Anti Burn", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- VIEW PCLD ИЗ POSRAL
    -- ============================================
    local viewPCLDConn = nil
    local pcldTransparency = 0.6

    ViewPCLDBlock:CreateSlider({
        Name = "Transparency",
        Min = 0,
        Max = 1,
        Default = 0.6,
        Rounding = 1,
        Callback = function(v)
            pcldTransparency = v
            -- Обновить существующие PCLD
            for _, v in pairs(Workspace:GetChildren()) do
                if v.Name == "PlayerCharacterLocationDetector" then
                    v.Transparency = pcldTransparency
                end
            end
        end
    })

    ViewPCLDBlock:CreateToggle({
        Name = "View PCLD",
        Default = false,
        Callback = function(Value)
            if viewPCLDConn then viewPCLDConn:Disconnect() viewPCLDConn = nil end
            
            if Value then
                -- Применить к существующим
                for _, v in pairs(Workspace:GetChildren()) do
                    if v.Name == "PlayerCharacterLocationDetector" then
                        v.Transparency = pcldTransparency
                    end
                end
                
                viewPCLDConn = Workspace.ChildAdded:Connect(function(child)
                    if child.Name == "PlayerCharacterLocationDetector" then
                        child.Transparency = pcldTransparency
                    end
                end)
                Library:Notify({ Title = "View PCLD", Content = "Enabled", Duration = 2 })
            else
                -- Скрыть все
                for _, v in pairs(Workspace:GetChildren()) do
                    if v.Name == "PlayerCharacterLocationDetector" then
                        v.Transparency = 1
                    end
                end
                Library:Notify({ Title = "View PCLD", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- ANTI-INPUT LAG ИЗ ABSOLUTE (СОХРАНЯЕМ)
    -- ============================================
    local InputToyList = {
        ["White Mug"] = "CupMugWhite",
        ["Brown Mug"] = "CupMugBrown",
        ["Hamburger"] = "FoodHamburger",
        ["Pizza"] = "FoodPizzaCheese",
        ["Hotdog"] = "FoodHotdog",
        ["French Fries"] = "FoodFrenchFries",
        ["Coconut"] = "FoodCoconut",
        ["Banana"] = "FoodBanana",
        ["Donut"] = "FoodDonut",
        ["Cake"] = "FoodCakePink",
        ["Egg"] = "FoodDippyEgg",
        ["Bread"] = "FoodBread",
        ["Mayonnaise"] = "FoodMayonnaise",
        ["Bugle"] = "InstrumentBrassBugle",
        ["Trumpet"] = "InstrumentBrassTrumpet",
        ["Vuvuzela"] = "InstrumentBrassVuvuzela",
        ["Bongos"] = "InstrumentDrumBongos",
        ["Snare Drum"] = "InstrumentDrumSnare",
        ["Acoustic Guitar"] = "InstrumentGuitarAcoustic",
        ["Banjo"] = "InstrumentGuitarBanjo",
        ["Lyre"] = "InstrumentGuitarLyre",
        ["Ukulele"] = "InstrumentGuitarUkulele",
        ["Violin"] = "InstrumentGuitarViolin",
        ["Keyboard"] = "InstrumentPianoKeyboard",
        ["Melodica"] = "InstrumentPianoMelodica",
        ["Microphone"] = "InstrumentVoiceMicrophone",
        ["Ocarina"] = "InstrumentWoodwindOcarina",
        ["Saxophone"] = "InstrumentWoodwindSaxophone",
    }

    local SelectedInputToy = "CupMugWhite"
    local antiInputActive = false
    local antiInputTask = nil
    local antiInputSpeed = 0.1

    local InputDropdownValues = {}
    for name, _ in pairs(InputToyList) do
        table.insert(InputDropdownValues, name)
    end
    table.sort(InputDropdownValues)

    AntiInputLagBlock:CreateDropdown({
        Name = "Select Item",
        Items = InputDropdownValues,
        Default = "White Mug",
        Callback = function(Value)
            SelectedInputToy = InputToyList[Value] or "CupMugWhite"
            Library:Notify({ Title = "Anti-Input", Content = "Selected: " .. Value, Duration = 2 })
        end
    })

    AntiInputLagBlock:CreateSlider({
        Name = "Cycle Speed (0.02 - 0.5 sec)",
        Min = 0.02,
        Max = 0.5,
        Default = 0.1,
        Rounding = 2,
        Suffix = "sec",
        Callback = function(Value)
            antiInputSpeed = Value
            Library:Notify({ Title = "Anti-Input", Content = "Speed: " .. string.format("%.2f", Value) .. " sec", Duration = 2 })
        end
    })

    local function StartAntiInput()
        if antiInputTask then task.cancel(antiInputTask) end
        antiInputTask = task.spawn(function()
            local RS = ReplicatedStorage
            local SpawnRemote = RS:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
            local HoldDuration = 0.02

            while antiInputActive do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    local toysFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                    local name = SelectedInputToy
                    local item = toysFolder and toysFolder:FindFirstChild(name)

                    for _, obj in pairs(Workspace:GetChildren()) do
                        if obj.Name == "Shuriken" and obj:IsA("Model") then
                            for _, part in pairs(obj:GetDescendants()) do
                                if part:IsA("BasePart") then 
                                    part.CanCollide = false 
                                    part.Massless = true 
                                end
                            end
                        end
                    end

                    if not item or not item.Parent then
                        task.spawn(function()
                            pcall(function()
                                SpawnRemote:InvokeServer(name, hrp.CFrame * CFrame.new(0, -12, 0), Vector3.zero)
                            end)
                        end)
                        task.wait(0.1)
                    else
                        local holdPart = item:FindFirstChild("HoldPart")
                        if holdPart then
                            for _, v in pairs(item:GetDescendants()) do
                                if v:IsA("BasePart") then 
                                    v.CanCollide = false 
                                    v.Massless = true 
                                end
                            end

                            task.spawn(function()
                                pcall(function()
                                    holdPart.HoldItemRemoteFunction:InvokeServer(item, char)
                                end)
                            end)

                            task.wait(HoldDuration)

                            task.spawn(function()
                                pcall(function()
                                    holdPart.DropItemRemoteFunction:InvokeServer(
                                        item, 
                                        CFrame.new(0, 5000, 0), 
                                        Vector3.zero
                                    )
                                end)
                            end)
                        end
                    end
                end
                task.wait(antiInputSpeed)
            end
        end)
    end

    local function StopAntiInput()
        antiInputActive = false
        if antiInputTask then 
            task.cancel(antiInputTask) 
            antiInputTask = nil 
        end
        
        task.spawn(function()
            local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            local destroyToy = RS:FindFirstChild("MenuToys") and RS.MenuToys:FindFirstChild("DestroyToy")
            if inv and destroyToy then
                for _, v in pairs(inv:GetChildren()) do 
                    if v.Name == SelectedInputToy then 
                        pcall(function() destroyToy:FireServer(v) end)
                    end
                end
            end
        end)
    end

    AntiInputLagBlock:CreateToggle({
        Name = "Anti-Input (Protection from input lag)",
        Default = false,
        Callback = function(Value)
            antiInputActive = Value
            if Value then 
                StartAntiInput() 
                Library:Notify({ Title = "Anti-Input", Content = "Enabled (Speed: " .. string.format("%.2f", antiInputSpeed) .. " sec)", Duration = 2 })
            else 
                StopAntiInput() 
                Library:Notify({ Title = "Anti-Input", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- ОСТАЛЬНОЙ ФУНКЦИОНАЛ ИЗ ABSOLUTE
    -- ============================================
    local GrabEvents = RS:WaitForChild("GrabEvents")
    local SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")
    local DestroyGrabLine = GrabEvents:WaitForChild("DestroyGrabLine")
    local CreateGrabLine = GrabEvents:WaitForChild("CreateGrabLine")
    local isHeld = LocalPlayer:WaitForChild("IsHeld")
    local struggleEvent = RS:WaitForChild("CharacterEvents"):WaitForChild("Struggle")
    local ragdollRemote = RS:WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

    local selectedTarget = nil
    local kickActive = false
    local kickTask = nil
    local holdHeight = 17
    local fovEnabled = false
    local originalFOV = 70

    local isAntiKickActive = false
    local antiKickTask = nil
    local infiniteRagdoll = false
    local infiniteRagdollTask = nil
    local antiGrabEnabled = false
    local antiGrabTask = nil

    local blobmanKickActive = false
    local blobmanKickTask = nil
    local blobmanTarget = nil
    local blobmanGrabInterval = 0.02
    local blobmanHoldHeight = 15

    local blobmanV2Target = nil
    local blobmanV2KickActive = false
    local blobmanV2KickTask = nil
    local blobmanV2GrabInterval = 0.02
    local blobmanV2HoldHeight = 15

    local antiLagActive = false

    local autoSitBlodmanActive = false
    local autoSitBlodmanTask = nil

    local createGrabLineCopy = nil
    local extendGrabLineCopy = nil
    local grabFolder = RS:FindFirstChild("GrabEvents")
    local createGrabLineOriginal = nil
    local extendGrabLineOriginal = nil
    local originalCharMoveStates = {}

    if grabFolder then
        createGrabLineOriginal = grabFolder:FindFirstChild("CreateGrabLine")
        extendGrabLineOriginal = grabFolder:FindFirstChild("ExtendGrabLine")
        if createGrabLineOriginal then
            createGrabLineCopy = createGrabLineOriginal:Clone()
        end
        if extendGrabLineOriginal then
            extendGrabLineCopy = extendGrabLineOriginal:Clone()
        end
    end

    local function SaveCharacterMoveStates()
        originalCharMoveStates = {}
        for _, player in pairs(Players:GetPlayers()) do
            local scripts = player:FindFirstChild("PlayerScripts")
            if scripts then
                local charMove = scripts:FindFirstChild("CharacterAndBeamMove")
                if charMove then
                    originalCharMoveStates[player] = charMove.Enabled
                end
            end
        end
    end

    local function RestoreCharacterMoveStates()
        for player, state in pairs(originalCharMoveStates) do
            local scripts = player:FindFirstChild("PlayerScripts")
            if scripts then
                local charMove = scripts:FindFirstChild("CharacterAndBeamMove")
                if charMove then
                    charMove.Enabled = state
                end
            end
        end
        originalCharMoveStates = {}
    end

    local function EnableAntiLag()
        for _, player in pairs(Players:GetPlayers()) do
            local scripts = player:FindFirstChild("PlayerScripts")
            if scripts then
                local charMove = scripts:FindFirstChild("CharacterAndBeamMove")
                if charMove then
                    if not originalCharMoveStates[player] then
                        originalCharMoveStates[player] = charMove.Enabled
                    end
                    charMove.Enabled = false
                end
            end
        end

        if grabFolder then
            local createLine = grabFolder:FindFirstChild("CreateGrabLine")
            local extendLine = grabFolder:FindFirstChild("ExtendGrabLine")
            
            if createLine and createLine ~= createGrabLineOriginal and createLine.Parent then
                createLine:Destroy()
            end
            if extendLine and extendLine ~= extendGrabLineOriginal and extendLine.Parent then
                extendLine:Destroy()
            end
            
            if createGrabLineCopy and not grabFolder:FindFirstChild("CreateGrabLine") then
                createGrabLineCopy:Clone().Parent = grabFolder
            end
            if extendGrabLineCopy and not grabFolder:FindFirstChild("ExtendGrabLine") then
                extendGrabLineCopy:Clone().Parent = grabFolder
            end
        end
    end

    local function DisableAntiLag()
        if grabFolder then
            local currentCreate = grabFolder:FindFirstChild("CreateGrabLine")
            local currentExtend = grabFolder:FindFirstChild("ExtendGrabLine")
            
            if currentCreate and currentCreate ~= createGrabLineOriginal then
                currentCreate:Destroy()
            end
            if currentExtend and currentExtend ~= extendGrabLineOriginal then
                currentExtend:Destroy()
            end
            
            if createGrabLineOriginal and not grabFolder:FindFirstChild("CreateGrabLine") then
                createGrabLineOriginal:Clone().Parent = grabFolder
            end
            if extendGrabLineOriginal and not grabFolder:FindFirstChild("ExtendGrabLine") then
                extendGrabLineOriginal:Clone().Parent = grabFolder
            end
        end

        RestoreCharacterMoveStates()
    end

    SaveCharacterMoveStates()

    AntiLagBlock:CreateToggle({
        Name = "Anti-Lag",
        Default = false,
        Callback = function(Value)
            antiLagActive = Value
            if Value then
                EnableAntiLag()
                Library:Notify({ Title = "Anti-Lag", Content = "Enabled", Duration = 2 })
            else
                DisableAntiLag()
                Library:Notify({ Title = "Anti-Lag", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- AUTO SIT BLODMAN
    -- ============================================
    local function AutoSitBlodmanLoop()
        while autoSitBlodmanActive do
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hrp and hum then
                if not hum.SeatPart then
                    local folderName = LocalPlayer.Name .. "SpawnedInToys"
                    local folder = workspace:FindFirstChild(folderName)
                    local blob = folder and folder:FindFirstChild("CreatureBlobman")
                    
                    if not blob then
                        task.spawn(function()
                            pcall(function()
                                RS.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", hrp.CFrame * CFrame.new(0, 5, 5), Vector3.zero)
                            end)
                        end)
                        
                        if not folder then
                            folder = workspace:WaitForChild(folderName, 5)
                        end
                        if folder then
                            blob = folder:WaitForChild("CreatureBlobman", 5)
                        end
                    end
                    
                    if blob then
                        local seat = blob:FindFirstChildWhichIsA("VehicleSeat")
                        if seat then
                            local t = tick()
                            repeat
                                if not hum.SeatPart then
                                    hrp.CFrame = seat.CFrame + Vector3.new(0, 1, 0)
                                    hrp.Velocity = Vector3.zero
                                    seat:Sit(hum)
                                end
                                RunService.Heartbeat:Wait()
                            until hum.SeatPart == seat or tick() - t > 1.5 or not autoSitBlodmanActive
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end

    BlodmanAutoSitBlock:CreateToggle({
        Name = "Auto Sit Blodman",
        Default = false,
        Callback = function(Value)
            autoSitBlodmanActive = Value
            if autoSitBlodmanTask then task.cancel(autoSitBlodmanTask) end
            if Value then
                autoSitBlodmanTask = task.spawn(AutoSitBlodmanLoop)
                Library:Notify({ Title = "Auto Sit Blodman", Content = "Enabled", Duration = 2 })
            else
                Library:Notify({ Title = "Auto Sit Blodman", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- ANTI-GRAB
    -- ============================================
    local function AntiGrabLoop()
        while antiGrabEnabled do
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if isHeld.Value then
                    pcall(function() struggleEvent:FireServer(LocalPlayer) end)
                    if hrp then
                        hrp.Anchored = true
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                    if hum then
                        hum.Sit = false
                        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                    end
                    local head = char:FindFirstChild("Head")
                    if head then
                        local partOwner = head:FindFirstChild("PartOwner")
                        if partOwner then partOwner:Destroy() end
                    end
                    pcall(function()
                        ragdollRemote:FireServer(hrp, 0)
                    end)
                else
                    if hrp and hrp.Anchored then hrp.Anchored = false end
                end
            end
            RunService.Heartbeat:Wait()
        end
    end

    AntiGrabBlock:CreateToggle({
        Name = "Anti-Grab",
        Default = false,
        Callback = function(Value)
            antiGrabEnabled = Value
            if antiGrabTask then task.cancel(antiGrabTask) antiGrabTask = nil end
            if Value then
                antiGrabTask = task.spawn(AntiGrabLoop)
                Library:Notify({ Title = "Anti-Grab", Content = "Enabled", Duration = 2 })
            else
                local char = LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then hrp.Anchored = false end
                end
                Library:Notify({ Title = "Anti-Grab", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- ANTI-KICK [SHURIKEN]
    -- ============================================
    local function ClearShuriken()
        local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if inv then
            for _, v in pairs(inv:GetChildren()) do
                if v:IsA("Model") and (v.Name == "AntiKick" or v.Name == "NinjaShuriken") then
                    pcall(function() RS.MenuToys.DestroyToy:FireServer(v) end)
                    task.wait(0.05)
                    if v and v.Parent then v:Destroy() end
                end
            end
        end
    end

    local function StartAntiKick()
        if isAntiKickActive then return end
        isAntiKickActive = true
        if antiKickTask then task.cancel(antiKickTask) antiKickTask = nil end
        antiKickTask = task.spawn(function()
            local setOwner = RS:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
            local stickyEvent = RS:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
            local spawnRemote = RS:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
            local canSpawn = LocalPlayer:WaitForChild("CanSpawnToy")
            local function getHRP()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    return LocalPlayer.Character.HumanoidRootPart
                else
                    return LocalPlayer.CharacterAdded:Wait():WaitForChild("HumanoidRootPart")
                end
            end
            local function CheckForHome()
                if not Workspace.PlotItems.PlayersInPlots:FindFirstChild(LocalPlayer.Name) then return false end
                for _, v in pairs(Workspace.Plots:GetChildren()) do
                    local sign = v:FindFirstChild("PlotSign")
                    local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                    if owners then
                        for _, b in pairs(owners:GetChildren()) do
                            if b.Value == LocalPlayer.Name then
                                local folder = Workspace.PlotItems:FindFirstChild(v.Name)
                                if folder then return true, folder end
                            end
                        end
                    end
                end
                return false
            end
            local function SpawnShurikenToy()
                local t = tick()
                while not canSpawn.Value do
                    if not isAntiKickActive or tick() - t > 5 then return nil end
                    task.wait(0.1)
                end
                local currentHRP = getHRP()
                if currentHRP then
                    task.spawn(function()
                        pcall(function()
                            spawnRemote:InvokeServer("NinjaShuriken", currentHRP.CFrame * CFrame.new(0, 12, 20), Vector3.new(0,0,0))
                        end)
                    end)
                end
                local boolik, house = CheckForHome()
                local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                if boolik and house then 
                    return house:WaitForChild("NinjaShuriken", 2)
                elseif not Workspace.PlotItems.PlayersInPlots:FindFirstChild(LocalPlayer.Name) and inv then 
                    return inv:WaitForChild("NinjaShuriken", 2)
                end
                return nil
            end
            local function StickShuriken(kunai)
                if not kunai or not kunai:FindFirstChild("StickyPart") then return end
                local currentHRP = getHRP()
                if not currentHRP then return end
                if kunai:FindFirstChild("SoundPart") then
                    if not kunai.SoundPart:FindFirstChild("PartOwner") or kunai.SoundPart.PartOwner.Value ~= LocalPlayer.Name then 
                        setOwner:FireServer(kunai.SoundPart, kunai.SoundPart.CFrame)
                    end
                end
                local firePart = currentHRP:FindFirstChild("FirePlayerPart") or currentHRP:WaitForChild("FirePlayerPart", 5)
                if firePart then
                    stickyEvent:FireServer(kunai.StickyPart, firePart, CFrame.new(0,0,0) * CFrame.Angles(0,math.rad(90),math.rad(90)))
                end
                for _, obj in pairs(kunai:GetChildren()) do
                    if obj:IsA("BasePart") then
                        obj.CanTouch = false
                        obj.CanCollide = false
                        obj.CanQuery = false
                    end
                end
            end
            while isAntiKickActive do 
                task.wait(0.005)
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then continue end
                local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                local kunai = inv and inv:FindFirstChild("NinjaShuriken")
                if Workspace.PlotItems.PlayersInPlots:FindFirstChild(LocalPlayer.Name) then 
                    local boolik, house = CheckForHome()
                    if boolik and house and Workspace.Plots:FindFirstChild(house.Name) then
                        local sign = Workspace.Plots[house.Name]:FindFirstChild("PlotSign")
                        if sign and sign.ThisPlotsOwners.Value.TimeRemainingNum.Value > 89 then 
                            kunai = SpawnShurikenToy()
                            if kunai == nil then continue end
                            kunai.Name = "AntiKick" 
                            StickShuriken(kunai)
                        end
                    end
                end
                if not kunai then
                    if Workspace.PlotItems.PlayersInPlots:FindFirstChild(LocalPlayer.Name) then continue end 
                    kunai = SpawnShurikenToy()
                    if kunai == nil then continue end 
                    kunai.Name = "AntiKick"
                    if not kunai then continue end 
                end
                repeat
                    if kunai and kunai:FindFirstChild("StickyPart") and kunai.StickyPart.CanTouch == true then
                        StickShuriken(kunai)
                        kunai.Name = "AntiKick"
                    end
                    task.wait(0.3)
                until not kunai or not isAntiKickActive or not kunai:FindFirstChild("StickyPart") or kunai.StickyPart.CanTouch == false 
                    or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
                    or not kunai:FindFirstChild("StickyPart") 
                    or (LocalPlayer.Character.HumanoidRootPart.Position - kunai.StickyPart.Position).Magnitude >= 20
                if not kunai or not kunai:FindFirstChild("StickyPart") or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or (LocalPlayer.Character.HumanoidRootPart.Position - kunai.StickyPart.Position).Magnitude >= 20 then 
                    ClearShuriken()
                end 
                pcall(function()
                    repeat task.wait(0.05) until not isAntiKickActive or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") or not kunai or not kunai:FindFirstChild("StickyPart") or not kunai.StickyPart:FindFirstChild("StickyWeld") or not kunai.StickyPart.StickyWeld.Part1
                    if not kunai or not kunai:FindFirstChild("StickyPart") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health <= 0) or not kunai["StickyPart"]:FindFirstChild("StickyWeld").Part1 then 
                        ClearShuriken()
                    end
                end)
            end
            ClearShuriken()
        end)
    end

    local function StopAntiKick()
        isAntiKickActive = false
        if antiKickTask then task.cancel(antiKickTask) antiKickTask = nil end
        ClearShuriken()
    end

    AntiKickBlock:CreateToggle({
        Name = "Anti-Kick [Shuriken]",
        Default = false,
        Callback = function(Value)
            if Value then 
                StartAntiKick() 
                Library:Notify({ Title = "Anti-Kick", Content = "Enabled", Duration = 2 })
            else 
                StopAntiKick() 
                Library:Notify({ Title = "Anti-Kick", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- ANTI-EXPLOSION
    -- ============================================
    local antiExplosionActive = false
    local antiExplosionConn = nil
    local function antiExplosionStart()
        antiExplosionActive = true
        antiExplosionConn = Workspace.ChildAdded:Connect(function(model)
            if not antiExplosionActive then return end
            if model:IsA("BasePart") and model.Name == "Part" then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if hrp and (model.Position - hrp.Position).Magnitude <= 25 then
                    pcall(function()
                        hrp.Anchored = true
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        model:Destroy()
                        task.wait(0.05)
                        hrp.Anchored = false
                        if hum then
                            hum.PlatformStand = false
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                    end)
                end
            end
        end)
    end

    AntiExplosionBlock:CreateToggle({
        Name = "Anti-Explosion",
        Default = false,
        Callback = function(Value)
            if Value then 
                antiExplosionStart() 
                Library:Notify({ Title = "Anti-Explosion", Content = "Enabled", Duration = 2 })
            else 
                antiExplosionActive = false 
                if antiExplosionConn then antiExplosionConn:Disconnect() antiExplosionConn = nil end
                Library:Notify({ Title = "Anti-Explosion", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- INFINITE RAGDOLL
    -- ============================================
    local function InfiniteRagdollLoop()
        while infiniteRagdoll do
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    ragdollRemote:FireServer(hrp, 0.5)
                end
            end)
            task.wait(0.05)
        end
    end

    AntiSnowBlock:CreateToggle({
        Name = "Infinite Ragdoll",
        Default = false,
        Callback = function(Value)
            infiniteRagdoll = Value
            if infiniteRagdollTask then task.cancel(infiniteRagdollTask) infiniteRagdollTask = nil end
            if Value then
                infiniteRagdollTask = task.spawn(InfiniteRagdollLoop)
                Library:Notify({ Title = "Infinite Ragdoll", Content = "Enabled", Duration = 2 })
            else
                Library:Notify({ Title = "Infinite Ragdoll", Content = "Disabled", Duration = 2 })
            end
        end
    })

    -- ============================================
    -- BLODMAN KICK
    -- ============================================
    local function BlodmanKickLoop()
        local target = blobmanTarget
        if not target then return end

        local GE = RS:WaitForChild("GrabEvents")
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local savedPos = myRoot.CFrame
        local currentHoldHeight = blobmanHoldHeight
        local dragging = false
        local grabStartTime = 0
        local spamCounter = 0

        while blobmanKickActive do
            local currentTarget = Players:FindFirstChild(target.Name)
            if not currentTarget or not currentTarget.Parent then break end

            myChar = LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tChar = currentTarget.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")

            local seat = myChar and myChar.Humanoid and myChar.Humanoid.SeatPart

            if tRoot and tHum and tHum.Health > 0 and myRoot and seat then
                tRoot.AssemblyLinearVelocity = Vector3.zero
                tRoot.Velocity = Vector3.zero

                local blobman = seat.Parent
                local remoteFolder = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
                
                if remoteFolder then
                    local grab = remoteFolder:FindFirstChild("CreatureGrab")
                    local release = remoteFolder:FindFirstChild("CreatureRelease")
                    
                    local R_Det = blobman:FindFirstChild("RightDetector")
                    local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChild("RigidConstraint"))

                    if grab and release and R_Weld then
                        
                        if not dragging then
                            myRoot.CFrame = tRoot.CFrame
                            if GE then
                                pcall(function()
                                    tHum.PlatformStand = true
                                    GE.SetNetworkOwner:FireServer(tRoot, myRoot.CFrame)
                                    GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                                end)
                            end
                            
                            if grabStartTime == 0 then grabStartTime = tick() end
                            if tick() - grabStartTime > 0.3 then
                                dragging = true
                                grabStartTime = 0
                            end
                        else
                            local lockPos = savedPos * CFrame.new(0, currentHoldHeight, 0)
                            myRoot.CFrame = savedPos
                            tRoot.CFrame = lockPos
                            
                            spamCounter = spamCounter + 1
                            
                            pcall(function()
                                grab:FireServer(R_Det, tRoot, R_Weld)
                            end)
                            
                            if spamCounter % 2 == 0 then
                                pcall(function()
                                    release:FireServer(R_Weld)
                                end)
                            end
                            
                            if GE then
                                pcall(function()
                                    tHum.PlatformStand = true
                                    GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                    GE.DestroyGrabLine:FireServer(tRoot)
                                    GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                                end)
                            end
                        end
                    end
                end
            else
                dragging = false
                grabStartTime = 0
                spamCounter = 0
                task.wait(0.1)
            end
            
            task.wait(blobmanGrabInterval)
        end

        if myRoot then
            myRoot.CFrame = savedPos
        end
        blobmanKickActive = false
    end

    BlodmanMainBlock:CreateToggle({
        Name = "BLODMAN KICK",
        Default = false,
        Callback = function(Value)
            blobmanKickActive = Value
            if blobmanKickTask then task.cancel(blobmanKickTask) blobmanKickTask = nil end
            if Value then
                if not blobmanTarget then
                    Library:Notify({ Title = "Error", Content = "Select target first", Duration = 3 })
                    return
                end
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChild("Humanoid")
                if not hum or not hum.SeatPart then
                    Library:Notify({ Title = "Error", Content = "Sit on Blobman", Duration = 3 })
                    return
                end
                blobmanKickTask = task.spawn(BlodmanKickLoop)
                Library:Notify({ Title = "BLODMAN KICK", Content = "Enabled", Duration = 2 })
            else
                Library:Notify({ Title = "BLODMAN KICK", Content = "Disabled", Duration = 2 })
            end
        end
    })

    BlodmanSettingsBlock:CreateSlider({
        Name = "Blodman Interval (0.01 - 0.1)",
        Min = 0.01,
        Max = 0.1,
        Default = 0.02,
        Rounding = 2,
        Callback = function(Value)
            blobmanGrabInterval = Value
        end
    })

    BlodmanSettingsBlock:CreateSlider({
        Name = "Hold Height",
        Min = 5,
        Max = 40,
        Default = 15,
        Rounding = 0,
        Callback = function(Value)
            blobmanHoldHeight = Value
        end
    })

    -- ============================================
    -- BLODMAN KICK v2
    -- ============================================
    local function BlobmanV2KickLoop()
        local target = blobmanV2Target
        if not target then return end

        local GE = RS:WaitForChild("GrabEvents")
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local savedPos = myRoot.CFrame
        local currentHoldHeight = blobmanV2HoldHeight
        local dragging = false
        local grabStartTime = 0
        local spamCounter = 0

        local hum = myChar and myChar:FindFirstChild("Humanoid")
        local seat = hum and hum.SeatPart
        if not seat or seat.Parent.Name ~= "CreatureBlobman" then
            Library:Notify({ Title = "Error", Content = "Sit on Blobman", Duration = 3 })
            return
        end

        local blob = seat.Parent
        local remoteFolder = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        local grab = remoteFolder and remoteFolder:FindFirstChild("CreatureGrab")
        local release = remoteFolder and remoteFolder:FindFirstChild("CreatureRelease")
        local R_Det = blob:FindFirstChild("RightDetector")
        local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChild("RigidConstraint"))

        if not (grab and release and R_Det and R_Weld) then
            Library:Notify({ Title = "Error", Content = "Blobman components not found", Duration = 3 })
            return
        end

        while blobmanV2KickActive do
            local currentTarget = Players:FindFirstChild(target.Name)
            if not currentTarget or not currentTarget.Parent then break end

            myChar = LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tChar = currentTarget.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")

            if tRoot and tHum and tHum.Health > 0 and myRoot and seat then
                tRoot.AssemblyLinearVelocity = Vector3.zero
                tRoot.Velocity = Vector3.zero

                if not dragging then
                    myRoot.CFrame = tRoot.CFrame
                    if GE then
                        pcall(function()
                            tHum.PlatformStand = true
                            GE.SetNetworkOwner:FireServer(tRoot, myRoot.CFrame)
                            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                        end)
                    end
                    
                    if grabStartTime == 0 then grabStartTime = tick() end
                    if tick() - grabStartTime > 0.3 then
                        dragging = true
                        grabStartTime = 0
                    end
                else
                    local lockPos = savedPos * CFrame.new(0, currentHoldHeight, 0)
                    myRoot.CFrame = savedPos
                    tRoot.CFrame = lockPos
                    
                    spamCounter = spamCounter + 1
                    
                    pcall(function()
                        grab:FireServer(R_Det, tRoot, R_Weld)
                    end)
                    
                    if spamCounter % 2 == 0 then
                        pcall(function()
                            release:FireServer(R_Weld)
                        end)
                    end
                    
                    if GE then
                        pcall(function()
                            tHum.PlatformStand = true
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.DestroyGrabLine:FireServer(tRoot)
                            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                        end)
                    end
                end
            else
                dragging = false
                grabStartTime = 0
                spamCounter = 0
                task.wait(0.1)
            end
            
            task.wait(blobmanV2GrabInterval)
        end

        if myRoot then
            myRoot.CFrame = savedPos
        end
        blobmanV2KickActive = false
    end

    BlodmanV2Block:CreateToggle({
        Name = "BLODMAN KICK v2 (Grab+Blob)",
        Default = false,
        Callback = function(Value)
            blobmanV2KickActive = Value
            if blobmanV2KickTask then task.cancel(blobmanV2KickTask) blobmanV2KickTask = nil end

            if Value then
                if not blobmanV2Target then
                    Library:Notify({ Title = "Error", Content = "Select target first", Duration = 3 })
                    return
                end

                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChild("Humanoid")
                if not hum or not hum.SeatPart then
                    Library:Notify({ Title = "Error", Content = "Sit on Blobman", Duration = 3 })
                    return
                end

                if hum.SeatPart.Parent.Name ~= "CreatureBlobman" then
                    Library:Notify({ Title = "Error", Content = "Sit on Blobman", Duration = 3 })
                    return
                end

                blobmanV2KickTask = task.spawn(BlobmanV2KickLoop)
                Library:Notify({ Title = "BLODMAN KICK v2", Content = "Enabled", Duration = 2 })
            else
                Library:Notify({ Title = "BLODMAN KICK v2", Content = "Disabled", Duration = 2 })
            end
        end
    })

    BlodmanV2SettingsBlock:CreateSlider({
        Name = "Interval (0.01 - 0.1)",
        Min = 0.01,
        Max = 0.1,
        Default = 0.02,
        Rounding = 2,
        Callback = function(Value)
            blobmanV2GrabInterval = Value
        end
    })

    BlodmanV2SettingsBlock:CreateSlider({
        Name = "Hold Height",
        Min = 5,
        Max = 40,
        Default = 15,
        Rounding = 0,
        Callback = function(Value)
            blobmanV2HoldHeight = Value
        end
    })

    -- ============================================
    -- VISUAL SETTINGS
    -- ============================================
    local function SetFOV(value)
        if value then
            originalFOV = Workspace.CurrentCamera.FieldOfView
            Workspace.CurrentCamera.FieldOfView = 120
        else
            Workspace.CurrentCamera.FieldOfView = originalFOV
        end
    end

    local function SetThirdPerson(enabled)
        if enabled then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMaxZoomDistance = 1000
            LocalPlayer.CameraMinZoomDistance = 0.5
        else
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
            LocalPlayer.CameraMaxZoomDistance = 0.5
            LocalPlayer.CameraMinZoomDistance = 0.5
        end
    }

    VisualBlock:CreateToggle({
        Name = "FOV 120",
        Default = false,
        Callback = function(Value)
            fovEnabled = Value
            SetFOV(Value)
        end
    })

    VisualBlock:CreateToggle({
        Name = "Third Person",
        Default = false,
        Callback = function(Value)
            SetThirdPerson(Value)
        end
    })

    -- ============================================
    -- ОБНОВЛЕНИЕ СПИСКОВ ПРИ ДОБАВЛЕНИИ/УДАЛЕНИИ ИГРОКОВ
    -- ============================================
    task.spawn(function()
        while true do
            updateList()
            if PosralTargetDropdown then
                pcall(function() PosralTargetDropdown:Refresh(targetNames, true) end)
            end
            if BlobmanTargetDropdown then
                pcall(function() BlobmanTargetDropdown:Refresh(targetNames, true) end)
            end
            if BlobmanV2TargetDropdown then
                pcall(function() BlobmanV2TargetDropdown:Refresh(targetNames, true) end)
            end
            task.wait(5)
        end
    end)

    -- Переменные для дропдаунов Blodman (создаем после обновления)
    local BlobmanTargetDropdown = BlodmanMainBlock:CreateDropdown({
        Name = "Select Target",
        Options = targetNames,
        Callback = function(v)
            blobmanTarget = getPlayerFromSelection(v)
        end
    })

    BlodmanMainBlock:CreateButton({
        Name = "Refresh List",
        Callback = function()
            updateList()
            BlobmanTargetDropdown:Refresh(targetNames, true)
        end
    })

    local BlobmanV2TargetDropdown = BlodmanV2Block:CreateDropdown({
        Name = "Select Target",
        Options = targetNames,
        Callback = function(v)
            blobmanV2Target = getPlayerFromSelection(v)
        end
    })

    BlodmanV2Block:CreateButton({
        Name = "Refresh List",
        Callback = function()
            updateList()
            BlobmanV2TargetDropdown:Refresh(targetNames, true)
        end
    })

    -- ============================================
    -- ОБРАБОТЧИК TELEPORT
    -- ============================================
    LocalPlayer.OnTeleport:Connect(function()
        kickActive = false
        if kickTask then task.cancel(kickTask) kickTask = nil end
        antiGrabEnabled = false
        if antiGrabTask then task.cancel(antiGrabTask) antiGrabTask = nil end
        if fovEnabled then SetFOV(false) fovEnabled = false end
        if isAntiKickActive then
            isAntiKickActive = false
            if antiKickTask then task.cancel(antiKickTask) antiKickTask = nil end
            ClearShuriken()
        end
        infiniteRagdoll = false
        if infiniteRagdollTask then task.cancel(infiniteRagdollTask) infiniteRagdollTask = nil end
        blobmanKickActive = false
        if blobmanKickTask then task.cancel(blobmanKickTask) blobmanKickTask = nil end
        blobmanV2KickActive = false
        if blobmanV2KickTask then task.cancel(blobmanV2KickTask) blobmanV2KickTask = nil end
        if antiLagActive then
            antiLagActive = false
            DisableAntiLag()
        end
        applyMethodActive = false
        if applyMethodTask then task.cancel(applyMethodTask) applyMethodTask = nil end
        
        -- Убираем PalletForRagdoll
        if PalletForRagdoll and PalletForRagdoll.Parent then
            DestroyToy(PalletForRagdoll)
        end
        PalletForRagdoll = nil
        
        -- Убираем BodyPosition
        local tt = PosralTargetSettings.Name and Players:FindFirstChild(PosralTargetSettings.Name)
        if tt and tt.Character then
            local tRoot = tt.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local bp = tRoot:FindFirstChild("BodyPosition")
                if bp then bp:Destroy() end
            end
        end
        
        -- Убираем Anti Burn коннекты
        if antiburn then antiburn:Disconnect() antiburn = nil end
        if antiburn1 then antiburn1:Disconnect() antiburn1 = nil end
        
        -- Убираем View PCLD
        if viewPCLDConn then viewPCLDConn:Disconnect() viewPCLDConn = nil end
        for _, v in pairs(Workspace:GetChildren()) do
            if v.Name == "PlayerCharacterLocationDetector" then
                v.Transparency = 1
            end
        end
    end)

    -- ============================================
    -- ОБРАБОТЧИК CHARACTER ADDED
    -- ============================================
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if antiGrabEnabled then antiGrabTask = task.spawn(AntiGrabLoop) end
        if fovEnabled then SetFOV(true) end
        if infiniteRagdoll then infiniteRagdollTask = task.spawn(InfiniteRagdollLoop) end
        if applyMethodActive and PalletForRagdoll and not PalletForRagdoll.Parent then
            SpawnPalletRagdoll()
        end
    end)

    Library:Notify({ Title = "Loaded", Content = "Absolute + Posral combined", Duration = 3 })
end

StartMainScript("Absolute + Posral")
