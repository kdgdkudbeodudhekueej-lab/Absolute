-- Mini Spin Kick Blobman + Visuals (с спам-грабом)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SpinKick_Mini"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/fleksmi-bot/Library2/refs/heads/main/Library1.lua"))()

local Window = Library:CreateWindow({
    Title = "Spin Kick Mini",
    Theme = "Night",
    ShowWatermark = { Enabled = true, Title = true, FPS = true, Ping = true },
    ToggleKey = Enum.KeyCode.RightShift,
})

-- Вкладки
local BlodmanTab = Window:CreateTab("Blodman", true)
local VisualTab = Window:CreateTab("Visual", true)

-- Блоки для Blodman
local BlodmanMainBlock = BlodmanTab:CreateBlock({Name = "SPIN KICK BLOBMAN (Spam Grab)", Side = "Left"})
local BlodmanSettingsBlock = BlodmanTab:CreateBlock({Name = "Settings", Side = "Right"})
local BlodmanAutoSitBlock = BlodmanTab:CreateBlock({Name = "Auto Sit Blodman", Side = "Left"})

-- Блок для Visual
local VisualBlock = VisualTab:CreateBlock({Name = "Visual Settings", Side = "Left"})

-- ============ ПЕРЕМЕННЫЕ ============
local RS = ReplicatedStorage
local targetNames = {}
local blobmanTarget = nil
local blobmanSpinKickActive = false
local blobmanSpinKickTask = nil
local blobmanGrabInterval = 0.02
local blobmanHoldHeight = 20
local autoSitBlodmanActive = false
local autoSitBlodmanTask = nil
local spamCounter = 0

-- ============ ФУНКЦИИ ДЛЯ СПИСКА ИГРОКОВ ============
local function updateList()
    targetNames = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local displayName = p.DisplayName or p.Name
            table.insert(targetNames, displayName .. " (" .. p.Name .. ")")
        end
    end
    if #targetNames == 0 then
        table.insert(targetNames, "No players")
    end
end

local function getPlayerFromSelection(selection)
    if not selection or selection == "" then return nil end
    local username = selection:match("%((.-)%)")
    if username then
        return Players:FindFirstChild(username)
    end
    return nil
end

-- Обновляем список при старте
updateList()

-- ============ SPIN KICK BLOBMAN (СПАМ-ГРАБ) ============
local function BlobmanSpinKickLoop()
    local target = blobmanTarget
    if not target then 
        Library:Notify({ Title = "Error", Content = "Select target first", Duration = 3 })
        return 
    end

    local GE = RS:WaitForChild("GrabEvents")
    if not GE then 
        Library:Notify({ Title = "Error", Content = "GrabEvents not found", Duration = 3 })
        return 
    end
    
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then 
        Library:Notify({ Title = "Error", Content = "Character not found", Duration = 3 })
        return 
    end

    local savedPos = myRoot.CFrame
    local currentHoldHeight = blobmanHoldHeight
    local dragging = false
    local grabStartTime = 0
    local orbitAngle = 0
    local ORBIT_RADIUS = 25
    local ORBIT_ANGULAR_SPEED = 25
    
    local hum = myChar and myChar:FindFirstChild("Humanoid")
    local seat = hum and hum.SeatPart
    if not seat or seat.Parent.Name ~= "CreatureBlobman" then
        Library:Notify({ Title = "Error", Content = "Sit on Blobman first!", Duration = 3 })
        return
    end

    local blob = seat.Parent
    local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
    local remoteFolder = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    local grab = remoteFolder and remoteFolder:FindFirstChild("CreatureGrab")
    local release = remoteFolder and remoteFolder:FindFirstChild("CreatureRelease")
    local R_Det = blob:FindFirstChild("RightDetector")
    local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChild("RigidConstraint"))

    if not (grab and release and R_Det and R_Weld) then
        Library:Notify({ Title = "Error", Content = "Blobman components not found", Duration = 3 })
        return
    end

    local lockedPcldWorldPos = nil
    local savedBlobCF = blobRoot and blobRoot.CFrame
    local spamCounter = 0

    Library:Notify({ Title = "Spin Kick", Content = "Started with Spam Grab!", Duration = 2 })

    while blobmanSpinKickActive do
        local currentTarget = Players:FindFirstChild(target.Name)
        if not currentTarget or not currentTarget.Parent then break end

        myChar = LocalPlayer.Character
        myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then break end
        
        local tChar = currentTarget.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChild("Humanoid")

        if tRoot and tHum and tHum.Health > 0 and myRoot and blobRoot then
            tRoot.AssemblyLinearVelocity = Vector3.zero
            tRoot.Velocity = Vector3.zero

            if not dragging then
                -- ФАЗА 1: ЗАХВАТ
                if grabStartTime == 0 then
                    grabStartTime = tick()
                    savedBlobCF = blobRoot.CFrame
                    -- Находим PCLD
                    for _, v in ipairs(tChar:GetChildren()) do
                        if v:IsA("BasePart") and string.lower(v.Name) == "playercharacterlocationdetector" then
                            lockedPcldWorldPos = v.Position
                            break
                        end
                    end
                    if not lockedPcldWorldPos then
                        lockedPcldWorldPos = tRoot.Position
                    end
                end

                -- Телепортируем блоба к цели
                blobRoot.CFrame = tRoot.CFrame
                blobRoot.Velocity = Vector3.zero
                
                pcall(function()
                    tHum.PlatformStand = true
                    tHum.Sit = true
                    GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                    GE.DestroyGrabLine:FireServer(tRoot)
                end)

                if tick() - grabStartTime > 0.35 then
                    -- Переход к вращению
                    dragging = true
                    grabStartTime = 0
                    orbitAngle = 0
                    spamCounter = 0
                    
                    -- Возвращаем блоба
                    if savedBlobCF then
                        blobRoot.CFrame = savedBlobCF
                        blobRoot.Velocity = Vector3.zero
                    end
                end
                task.wait(blobmanGrabInterval)
            else
                -- ФАЗА 2: ВРАЩЕНИЕ ПО КРУГУ + СПАМ-ГРАБ
                local dt = RunService.Heartbeat:Wait()
                orbitAngle = orbitAngle + ORBIT_ANGULAR_SPEED * dt

                local basePos = lockedPcldWorldPos or tRoot.Position

                -- Определяем высоту земли
                local rayOrigin = basePos + Vector3.new(0, 10, 0)
                local rayDir = Vector3.new(0, -50, 0)
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {tChar, myChar, blob}

                local groundY = basePos.Y
                local raycastResult = workspace:Raycast(rayOrigin, rayDir, rayParams)
                if raycastResult then
                    groundY = raycastResult.Position.Y
                end

                -- Позиция на высоте holdHeight от земли
                local orbitCenter = Vector3.new(basePos.X, groundY + currentHoldHeight, basePos.Z)
                
                local offset = Vector3.new(
                    math.cos(orbitAngle) * ORBIT_RADIUS,
                    0,
                    math.sin(orbitAngle) * ORBIT_RADIUS
                )
                local orbitPos = orbitCenter + offset

                -- Двигаем блоба по орбите
                blobRoot.CFrame = CFrame.lookAt(orbitPos, orbitCenter)
                blobRoot.Velocity = Vector3.zero
                pcall(function()
                    blobRoot.AssemblyLinearVelocity = Vector3.zero
                    blobRoot.AssemblyAngularVelocity = Vector3.zero
                end)

                -- Удерживаем цель в центре
                local targetPos = Vector3.new(basePos.X, groundY + currentHoldHeight, basePos.Z)
                tRoot.CFrame = CFrame.new(targetPos) * tRoot.CFrame.Rotation
                tHum.PlatformStand = true
                tHum.Sit = true

                -- ===== СПАМ-ГРАБ (как в Kick V2) =====
                spamCounter = spamCounter + 1
                
                pcall(function()
                    -- Спамим граб через детектор
                    grab:FireServer(R_Det, tRoot, R_Weld)
                end)
                
                -- Каждые 2 раза делаем релиз для перезахвата
                if spamCounter % 2 == 0 then
                    pcall(function()
                        release:FireServer(R_Weld)
                    end)
                end
                
                -- Отправка сетевых событий
                pcall(function()
                    local targetCF = CFrame.new(targetPos) * tRoot.CFrame.Rotation
                    GE.SetNetworkOwner:FireServer(tRoot, targetCF)
                    GE.DestroyGrabLine:FireServer(tRoot)
                end)
                
                task.wait(blobmanGrabInterval)
            end
        else
            dragging = false
            grabStartTime = 0
            lockedPcldWorldPos = nil
            spamCounter = 0
            task.wait(0.1)
        end
    end

    -- Возвращаем блоба на место
    if savedBlobCF and blobRoot then
        blobRoot.CFrame = savedBlobCF
        blobRoot.Velocity = Vector3.zero
    end
    blobmanSpinKickActive = false
    
    Library:Notify({ Title = "Spin Kick", Content = "Stopped", Duration = 2 })
end

-- ============ AUTO SIT BLOBMAN ============
local function AutoSitBlodmanLoop()
    while autoSitBlodmanActive do
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp and hum then
            if not hum.SeatPart then
                local folderName = LocalPlayer.Name .. "SpawnedInToys"
                local folder = workspace:FindFirstChild(folderName)
                local blob = folder and folder:FindFirstChild("CreatureBlobman")
                
                if not blob then
                    task.spawn(function()
                        pcall(function()
                            RS.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", hrp.CFrame * CFrame.new(0, 5, 5), Vector3.zero)
                        end)
                    end)
                    
                    if not folder then
                        folder = workspace:WaitForChild(folderName, 5)
                    end
                    if folder then
                        blob = folder:WaitForChild("CreatureBlobman", 5)
                    end
                end
                
                if blob then
                    local seat = blob:FindFirstChildWhichIsA("VehicleSeat")
                    if seat then
                        local t = tick()
                        repeat
                            if not hum.SeatPart then
                                hrp.CFrame = seat.CFrame + Vector3.new(0, 1, 0)
                                hrp.Velocity = Vector3.zero
                                seat:Sit(hum)
                            end
                            RunService.Heartbeat:Wait()
                        until hum.SeatPart == seat or tick() - t > 1.5 or not autoSitBlodmanActive
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

-- ============ ВИЗУАЛЬНЫЕ НАСТРОЙКИ ============
local fovEnabled = false
local originalFOV = 70

local function SetFOV(value)
    if value then
        originalFOV = Workspace.CurrentCamera.FieldOfView
        Workspace.CurrentCamera.FieldOfView = 120
    else
        Workspace.CurrentCamera.FieldOfView = originalFOV
    end
end

local function SetThirdPerson(enabled)
    if enabled then
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMaxZoomDistance = 1000
        LocalPlayer.CameraMinZoomDistance = 0.5
    else
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        LocalPlayer.CameraMaxZoomDistance = 0.5
        LocalPlayer.CameraMinZoomDistance = 0.5
    end
end

-- ============ UI ЭЛЕМЕНТЫ ============

-- Выбор цели
local BlobmanTargetDropdown = BlodmanMainBlock:CreateDropdown({
    Name = "Select Target",
    Options = targetNames,
    Callback = function(v)
        blobmanTarget = getPlayerFromSelection(v)
    end
})

BlodmanMainBlock:CreateButton({
    Name = "Refresh List",
    Callback = function()
        updateList()
        BlobmanTargetDropdown:Refresh(targetNames, true)
    end
})

-- Включение Spin Kick
BlodmanMainBlock:CreateToggle({
    Name = "SPIN KICK BLOBMAN (Spam Grab)",
    Default = false,
    Callback = function(Value)
        blobmanSpinKickActive = Value
        if blobmanSpinKickTask then task.cancel(blobmanSpinKickTask) blobmanSpinKickTask = nil end

        if Value then
            if not blobmanTarget then
                Library:Notify({ Title = "Error", Content = "Select target first", Duration = 3 })
                return
            end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            if not hum or not hum.SeatPart then
                Library:Notify({ Title = "Error", Content = "Sit on Blobman first!", Duration = 3 })
                return
            end

            if hum.SeatPart.Parent.Name ~= "CreatureBlobman" then
                Library:Notify({ Title = "Error", Content = "Sit on Blobman!", Duration = 3 })
                return
            end

            blobmanSpinKickTask = task.spawn(BlobmanSpinKickLoop)
        end
    end
})

-- Настройки
BlodmanSettingsBlock:CreateSlider({
    Name = "Interval (0.01 - 0.1)",
    Min = 0.01,
    Max = 0.1,
    Default = 0.02,
    Rounding = 2,
    Callback = function(Value)
        blobmanGrabInterval = Value
    end
})

BlodmanSettingsBlock:CreateSlider({
    Name = "Hold Height (5 - 40)",
    Min = 5,
    Max = 40,
    Default = 20,
    Rounding = 0,
    Callback = function(Value)
        blobmanHoldHeight = Value
    end
})

-- Auto Sit
BlodmanAutoSitBlock:CreateToggle({
    Name = "Auto Sit Blodman",
    Default = false,
    Callback = function(Value)
        autoSitBlodmanActive = Value
        if autoSitBlodmanTask then task.cancel(autoSitBlodmanTask) end
        if Value then
            autoSitBlodmanTask = task.spawn(AutoSitBlodmanLoop)
            Library:Notify({ Title = "Auto Sit", Content = "Enabled", Duration = 2 })
        else
            Library:Notify({ Title = "Auto Sit", Content = "Disabled", Duration = 2 })
        end
    end
})

-- Visual настройки
VisualBlock:CreateToggle({
    Name = "FOV 120",
    Default = false,
    Callback = function(Value)
        fovEnabled = Value
        SetFOV(Value)
        Library:Notify({ Title = "FOV", Content = Value and "120" or "Default (" .. originalFOV .. ")", Duration = 2 })
    end
})

VisualBlock:CreateToggle({
    Name = "Third Person",
    Default = false,
    Callback = function(Value)
        SetThirdPerson(Value)
        Library:Notify({ Title = "Camera", Content = Value and "Third Person" or "First Person", Duration = 2 })
    end
})

-- Обновление списка игроков
task.spawn(function()
    while true do
        updateList()
        pcall(function() 
            BlobmanTargetDropdown:Refresh(targetNames, true) 
        end)
        task.wait(5)
    end
end)

-- Сброс при телепорте
LocalPlayer.OnTeleport:Connect(function()
    blobmanSpinKickActive = false
    if blobmanSpinKickTask then task.cancel(blobmanSpinKickTask) blobmanSpinKickTask = nil end
    if fovEnabled then SetFOV(false) fovEnabled = false end
end)

Library:Notify({ Title = "Spin Kick Mini", Content = "Loaded with Spam Grab!", Duration = 3 })
