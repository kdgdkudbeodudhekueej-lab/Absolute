-- Мини-скрипт: Ownership Kick (с Attachment/Align), Third Person, FOV 120

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Mini_Absolute"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

function StartMiniScript(titleText)
    local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/fleksmi-bot/Library2/refs/heads/main/Library1.lua"))()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer
    local RS = ReplicatedStorage

    local Window = Library:CreateWindow({
        Title = titleText,
        Theme = "Night",
        ShowWatermark = { Enabled = true, Title = true, User = false, FPS = true, Duration = false, Ping = true, Time= false },
        ToggleKey = Enum.KeyCode.RightShift,
    })

    local MainTab = Window:CreateTab("Main", true)
    local VisualTab = Window:CreateTab("Visual", true)

    local KickBlock = MainTab:CreateBlock({Name = "Ownership Kick", Side = "Left"})
    local TargetBlock = MainTab:CreateBlock({Name = "Target", Side = "Left"})
    local VisualBlock = VisualTab:CreateBlock({Name = "Visual Settings", Side = "Left"})

    local selectedTarget = nil
    local kickActive = false
    local kickTask = nil
    local holdHeight = 17
    local fovEnabled = false
    local originalFOV = 70

    local GrabEvents = RS:WaitForChild("GrabEvents")
    local SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")
    local DestroyGrabLine = GrabEvents:WaitForChild("DestroyGrabLine")

    local targetNames = {}
    local function updateList()
        targetNames = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local displayName = p.DisplayName or p.Name
                table.insert(targetNames, displayName .. " (" .. p.Name .. ")")
            end
        end
    end

    local function getPlayerFromSelection(selection)
        if not selection or selection == "" then return nil end
        local username = selection:match("%((.-)%)")
        if username then
            return Players:FindFirstChild(username)
        end
        return nil
    end

    local TargetDropdown = TargetBlock:CreateDropdown({
        Name = "Select Target",
        Options = targetNames,
        Callback = function(v)
            selectedTarget = getPlayerFromSelection(v)
        end
    })

    TargetBlock:CreateButton({
        Name = "Refresh List",
        Callback = function()
            updateList()
            TargetDropdown:Refresh(targetNames, true)
        end
    })

    local function SetFOV(value)
        if value then
            originalFOV = Workspace.CurrentCamera.FieldOfView
            Workspace.CurrentCamera.FieldOfView = 120
        else
            Workspace.CurrentCamera.FieldOfView = originalFOV
        end
    end

    local function SetThirdPerson(enabled)
        if enabled then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMaxZoomDistance = 1000
            LocalPlayer.CameraMinZoomDistance = 0.5
        else
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
            LocalPlayer.CameraMaxZoomDistance = 0.5
            LocalPlayer.CameraMinZoomDistance = 0.5
        end
    end

    VisualBlock:CreateToggle({
        Name = "FOV 120",
        Default = false,
        Callback = function(Value)
            fovEnabled = Value
            SetFOV(Value)
        end
    })

    VisualBlock:CreateToggle({
        Name = "Third Person",
        Default = false,
        Callback = function(Value)
            SetThirdPerson(Value)
        end
    })

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if fovEnabled then SetFOV(true) end
    end)

    -- Функция для создания Attachment и Align объектов
    local function CreateKickAttachments(targetRoot, targetHead, lockPos)
        -- Очищаем старые объекты
        for _, child in pairs(targetRoot:GetChildren()) do
            if child:IsA("Attachment") or child:IsA("AlignPosition") or child:IsA("AlignOrientation") then
                child:Destroy()
            end
        end
        
        -- Создаем Attachment на корне цели
        local targetAttach = Instance.new("Attachment")
        targetAttach.Name = "KickAttachment"
        targetAttach.Parent = targetRoot
        targetAttach.Position = Vector3.new(0, 0, 0)
        targetAttach.WorldPosition = lockPos.Position
        
        -- Создаем Attachment на голове (для привязки позиции)
        local headAttach = Instance.new("Attachment")
        headAttach.Name = "KickAttachment"
        headAttach.Parent = targetHead
        headAttach.Position = Vector3.new(0, 0, 0)
        
        -- AlignPosition для удержания на месте
        local alignPos = Instance.new("AlignPosition")
        alignPos.Name = "KickAlignPosition"
        alignPos.Parent = targetRoot
        alignPos.Attachment0 = targetAttach
        alignPos.Attachment1 = headAttach
        alignPos.Enabled = true
        alignPos.ReactionForceEnabled = false
        alignPos.Responsiveness = 500
        alignPos.MaxForce = 9e9
        alignPos.MaxVelocity = 500
        
        -- AlignOrientation для контроля вращения
        local alignOri = Instance.new("AlignOrientation")
        alignOri.Name = "KickAlignOrientation"
        alignOri.Parent = targetRoot
        alignOri.Attachment0 = targetAttach
        alignOri.Attachment1 = headAttach
        alignOri.Enabled = true
        alignOri.ReactionTorqueEnabled = false
        alignOri.Responsiveness = 500
        alignOri.MaxTorque = 9e9
        
        return targetAttach, headAttach, alignPos, alignOri
    end

    local function CleanupKick(target)
        if not target then return end
        local char = target.Character
        if not char then return end
        
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        
        if root then
            for _, child in pairs(root:GetChildren()) do
                if child:IsA("Attachment") or child:IsA("AlignPosition") or child:IsA("AlignOrientation") then
                    child:Destroy()
                end
            end
        end
        
        if head then
            for _, child in pairs(head:GetChildren()) do
                if child:IsA("Attachment") then
                    child:Destroy()
                end
            end
        end
    end

    local function OwnershipKickFunction(targetName)
        local target = Players:FindFirstChild(targetName)
        if not target then return end
        
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local savedPos = myRoot.CFrame 
        local dragging = false
        local grabStartTime = 0
        local checkStartTime = 0
        
        local currentFPS = 60
        local fpsConnection = RunService.RenderStepped:Connect(function(dt)
            currentFPS = 1 / dt
        end)

        local targetAttach, headAttach, alignPos, alignOri = nil, nil, nil, nil

        while kickActive do
            local currentTarget = Players:FindFirstChild(target.Name)
            if not currentTarget or not currentTarget.Parent then 
                CleanupKick(target)
                break 
            end
            
            myChar = LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tChar = currentTarget.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHead = tChar and tChar:FindFirstChild("Head")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")
            
            if tRoot and tHead and tHum and tHum.Health > 0 and myRoot then
                if not dragging then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                    CleanupKick(target)
                    checkStartTime = 0
                    pcall(function()
                        tHum.PlatformStand = true
                        tHum.Sit = true
                        SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                        SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                        DestroyGrabLine:FireServer(tRoot)
                    end)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    if grabStartTime == 0 then grabStartTime = tick() end
                    if tick() - grabStartTime > 0.35 then
                        dragging = true
                        grabStartTime = 0
                        checkStartTime = tick()
                        local lockPos = savedPos * CFrame.new(0, holdHeight, 0)
                        targetAttach, headAttach, alignPos, alignOri = CreateKickAttachments(tRoot, tHead, lockPos)
                    end
                else
                    myRoot.CFrame = savedPos
                    local lockPos = savedPos * CFrame.new(0, holdHeight, 0)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    
                    -- Обновляем позицию через AlignPosition
                    if targetAttach and targetAttach.Parent then
                        targetAttach.WorldPosition = lockPos.Position
                    end
                    
                    if alignPos and alignPos.Parent then
                        alignPos.Enabled = true
                    end
                    
                    if alignOri and alignOri.Parent then
                        alignOri.Enabled = true
                    end
                    
                    tHum.PlatformStand = true
                    pcall(function()
                        if currentFPS > 200 then
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            DestroyGrabLine:FireServer(tRoot)
                        elseif currentFPS >= 155 and currentFPS <= 200 then
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            DestroyGrabLine:FireServer(tRoot)
                        else
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            SetNetworkOwner:FireServer(tRoot, lockPos)
                            DestroyGrabLine:FireServer(tRoot)
                        end
                    end)
                    
                    if checkStartTime > 0 and tick() - checkStartTime > 0.30 then
                        local currentDist = (tRoot.Position - lockPos.Position).Magnitude
                        if currentDist > 10 then
                            dragging = false
                            grabStartTime = 0
                            checkStartTime = 0
                            CleanupKick(target)
                            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        else
                            checkStartTime = tick()
                        end
                    end
                end
            else
                dragging = false
                grabStartTime = 0
                checkStartTime = 0
                CleanupKick(target)
                targetAttach, headAttach, alignPos, alignOri = nil, nil, nil, nil
            end
            RunService.Heartbeat:Wait()
        end
        
        fpsConnection:Disconnect()
        CleanupKick(target)
        if myRoot then myRoot.CFrame = savedPos end
        if target and target.Character then
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                pcall(function() DestroyGrabLine:FireServer(tRoot) end)
            end
        end
    end

    KickBlock:CreateToggle({
        Name = "Enable Ownership Kick",
        Default = false,
        Callback = function(Value)
            if Value then
                if not selectedTarget then
                    Library:Notify({ Title = "Error", Content = "Select target", Duration = 3 })
                    return
                end
                kickActive = true
                if kickTask then task.cancel(kickTask) kickTask = nil end
                kickTask = task.spawn(function() OwnershipKickFunction(selectedTarget.Name) end)
                Library:Notify({ Title = "Ownership Kick", Content = "Enabled", Duration = 2 })
            else
                kickActive = false
                if kickTask then task.cancel(kickTask) kickTask = nil end
                CleanupKick(selectedTarget)
                if selectedTarget and selectedTarget.Character then
                    local tRoot = selectedTarget.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot then
                        for _, v in pairs(tRoot:GetChildren()) do
                            if v:IsA("Attachment") or v:IsA("AlignPosition") or v:IsA("AlignOrientation") then
                                pcall(function() v:Destroy() end)
                            end
                        end
                        pcall(function()
                            tRoot.AssemblyLinearVelocity = Vector3.zero
                            tRoot.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                end
                Library:Notify({ Title = "Ownership Kick", Content = "Disabled", Duration = 2 })
            end
        end
    })

    KickBlock:CreateSlider({
        Name = "Hold Height",
        Min = 5,
        Max = 40,
        Default = 17,
        Rounding = 0,
        Callback = function(Value) holdHeight = Value end
    })

    task.spawn(function()
        while true do
            updateList()
            if TargetDropdown then
                pcall(function() TargetDropdown:Refresh(targetNames, true) end)
            end
            task.wait(5)
        end
    end)

    LocalPlayer.OnTeleport:Connect(function()
        kickActive = false
        if kickTask then task.cancel(kickTask) kickTask = nil end
        CleanupKick(selectedTarget)
        if fovEnabled then SetFOV(false) fovEnabled = false end
    end)
end

StartMiniScript("Mini Absolute")
