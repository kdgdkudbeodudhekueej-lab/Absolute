-- Мини-скрипт: Ownership Kick (с нуля), Third Person, FOV 120

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Mini_Absolute"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

function StartMiniScript(titleText)
    local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/fleksmi-bot/Library2/refs/heads/main/Library1.lua"))()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer
    local RS = ReplicatedStorage

    local Window = Library:CreateWindow({
        Title = titleText,
        Theme = "Night",
        ShowWatermark = { Enabled = true, Title = true, User = false, FPS = true, Duration = false, Ping = true, Time= false },
        ToggleKey = Enum.KeyCode.RightShift,
    })

    local MainTab = Window:CreateTab("Main", true)
    local VisualTab = Window:CreateTab("Visual", true)

    local KickBlock = MainTab:CreateBlock({Name = "Ownership Kick", Side = "Left"})
    local TargetBlock = MainTab:CreateBlock({Name = "Target", Side = "Left"})
    local VisualBlock = VisualTab:CreateBlock({Name = "Visual Settings", Side = "Left"})

    local selectedTarget = nil
    local kickActive = false
    local kickTask = nil
    local holdHeight = 17
    local fovEnabled = false
    local originalFOV = 70

    local GrabEvents = RS:WaitForChild("GrabEvents")
    local SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")
    local DestroyGrabLine = GrabEvents:WaitForChild("DestroyGrabLine")

    local targetNames = {}
    local function updateList()
        targetNames = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local displayName = p.DisplayName or p.Name
                table.insert(targetNames, displayName .. " (" .. p.Name .. ")")
            end
        end
    end

    local function getPlayerFromSelection(selection)
        if not selection or selection == "" then return nil end
        local username = selection:match("%((.-)%)")
        if username then
            return Players:FindFirstChild(username)
        end
        return nil
    end

    local TargetDropdown = TargetBlock:CreateDropdown({
        Name = "Select Target",
        Options = targetNames,
        Callback = function(v)
            selectedTarget = getPlayerFromSelection(v)
        end
    })

    TargetBlock:CreateButton({
        Name = "Refresh List",
        Callback = function()
            updateList()
            TargetDropdown:Refresh(targetNames, true)
        end
    })

    local function SetFOV(value)
        if value then
            originalFOV = Workspace.CurrentCamera.FieldOfView
            Workspace.CurrentCamera.FieldOfView = 120
        else
            Workspace.CurrentCamera.FieldOfView = originalFOV
        end
    end

    local function SetThirdPerson(enabled)
        if enabled then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMaxZoomDistance = 1000
            LocalPlayer.CameraMinZoomDistance = 0.5
        else
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
            LocalPlayer.CameraMaxZoomDistance = 0.5
            LocalPlayer.CameraMinZoomDistance = 0.5
        end
    end

    VisualBlock:CreateToggle({
        Name = "FOV 120",
        Default = false,
        Callback = function(Value)
            fovEnabled = Value
            SetFOV(Value)
        end
    })

    VisualBlock:CreateToggle({
        Name = "Third Person",
        Default = false,
        Callback = function(Value)
            SetThirdPerson(Value)
        end
    })

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if fovEnabled then SetFOV(true) end
    end)

    -- Очистка объектов на цели
    local function CleanupTarget(target)
        if not target then return end
        local character = target.Character
        if not character then return end
        
        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        
        if root then
            for _, child in pairs(root:GetChildren()) do
                if child:IsA("Attachment") or child:IsA("AlignPosition") or child:IsA("AlignOrientation") then
                    child:Destroy()
                end
            end
        end
        
        if head then
            for _, child in pairs(head:GetChildren()) do
                if child:IsA("Attachment") then
                    child:Destroy()
                end
            end
        end
    end

    -- Создание Attachment и Align объектов
    local function CreateAttachments(targetRoot, targetHead, targetPos)
        -- Удаляем старые объекты
        for _, child in pairs(targetRoot:GetChildren()) do
            if child:IsA("Attachment") or child:IsA("AlignPosition") or child:IsA("AlignOrientation") then
                child:Destroy()
            end
        end
        
        -- Attachment на корне
        local rootAttach = Instance.new("Attachment")
        rootAttach.Name = "KickRootAttachment"
        rootAttach.Parent = targetRoot
        rootAttach.Position = Vector3.new(0, 0, 0)
        rootAttach.WorldPosition = targetPos
        
        -- Attachment на голове
        local headAttach = Instance.new("Attachment")
        headAttach.Name = "KickHeadAttachment"
        headAttach.Parent = targetHead
        headAttach.Position = Vector3.new(0, 0, 0)
        
        -- AlignPosition для удержания позиции
        local alignPos = Instance.new("AlignPosition")
        alignPos.Name = "KickAlignPosition"
        alignPos.Parent = targetRoot
        alignPos.Attachment0 = rootAttach
        alignPos.Attachment1 = headAttach
        alignPos.Enabled = true
        alignPos.ReactionForceEnabled = false
        alignPos.Responsiveness = 1000
        alignPos.MaxForce = 9e9
        alignPos.MaxVelocity = 1000
        
        -- AlignOrientation для контроля вращения
        local alignOri = Instance.new("AlignOrientation")
        alignOri.Name = "KickAlignOrientation"
        alignOri.Parent = targetRoot
        alignOri.Attachment0 = rootAttach
        alignOri.Attachment1 = headAttach
        alignOri.Enabled = true
        alignOri.ReactionTorqueEnabled = false
        alignOri.Responsiveness = 1000
        alignOri.MaxTorque = 9e9
        
        return rootAttach, headAttach, alignPos, alignOri
    end

    -- Основная функция кика
    local function KickFunction(targetName)
        local target = Players:FindFirstChild(targetName)
        if not target then return end
        
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local savedPosition = myRoot.CFrame
        local isDragging = false
        local grabStartTime = 0
        local checkStartTime = 0
        
        local rootAttach, headAttach, alignPos, alignOri = nil, nil, nil, nil
        
        while kickActive do
            local currentTarget = Players:FindFirstChild(target.Name)
            if not currentTarget or not currentTarget.Parent then 
                CleanupTarget(target)
                break 
            end
            
            myCharacter = LocalPlayer.Character
            myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
            
            local targetChar = currentTarget.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local targetHead = targetChar and targetChar:FindFirstChild("Head")
            local targetHumanoid = targetChar and targetChar:FindFirstChild("Humanoid")
            
            if targetRoot and targetHead and targetHumanoid and targetHumanoid.Health > 0 and myRoot then
                if not isDragging then
                    -- Первая фаза: подходим к цели
                    myRoot.PivotTo(targetRoot.CFrame * CFrame.new(0, 0, 3))
                    CleanupTarget(target)
                    checkStartTime = 0
                    
                    pcall(function()
                        targetHumanoid.PlatformStand = true
                        targetHumanoid.Sit = true
                        SetNetworkOwner:FireServer(targetRoot, targetRoot.CFrame)
                        SetNetworkOwner:FireServer(targetRoot, targetRoot.CFrame)
                        DestroyGrabLine:FireServer(targetRoot)
                    end)
                    
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    
                    if grabStartTime == 0 then grabStartTime = tick() end
                    if tick() - grabStartTime > 0.35 then
                        isDragging = true
                        grabStartTime = 0
                        checkStartTime = tick()
                        
                        local lockPosition = savedPosition * CFrame.new(0, holdHeight, 0)
                        rootAttach, headAttach, alignPos, alignOri = CreateAttachments(targetRoot, targetHead, lockPosition.Position)
                    end
                else
                    -- Вторая фаза: удерживаем цель
                    myRoot.PivotTo(savedPosition)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    
                    local lockPosition = savedPosition * CFrame.new(0, holdHeight, 0)
                    
                    -- Обновляем позицию через Attachment
                    if rootAttach and rootAttach.Parent then
                        rootAttach.WorldPosition = lockPosition.Position
                    end
                    
                    if alignPos and alignPos.Parent then
                        alignPos.Enabled = true
                    end
                    
                    if alignOri and alignOri.Parent then
                        alignOri.Enabled = true
                    end
                    
                    targetHumanoid.PlatformStand = true
                    
                    pcall(function()
                        SetNetworkOwner:FireServer(targetRoot, lockPosition)
                        SetNetworkOwner:FireServer(targetRoot, lockPosition)
                        SetNetworkOwner:FireServer(targetRoot, lockPosition)
                        SetNetworkOwner:FireServer(targetRoot, lockPosition)
                        DestroyGrabLine:FireServer(targetRoot)
                    end)
                    
                    -- Проверка: не сбежала ли цель
                    if checkStartTime > 0 and tick() - checkStartTime > 0.30 then
                        local currentDistance = (targetRoot.Position - lockPosition.Position).Magnitude
                        if currentDistance > 10 then
                            isDragging = false
                            grabStartTime = 0
                            checkStartTime = 0
                            CleanupTarget(target)
                            myRoot.PivotTo(targetRoot.CFrame * CFrame.new(0, 0, 3))
                        else
                            checkStartTime = tick()
                        end
                    end
                end
            else
                isDragging = false
                grabStartTime = 0
                checkStartTime = 0
                CleanupTarget(target)
                rootAttach, headAttach, alignPos, alignOri = nil, nil, nil, nil
            end
            RunService.Heartbeat:Wait()
        end
        
        -- Очистка при завершении
        CleanupTarget(target)
        if myRoot then myRoot.PivotTo(savedPosition) end
        if target and target.Character then
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                pcall(function() DestroyGrabLine:FireServer(targetRoot) end)
            end
        end
    end

    KickBlock:CreateToggle({
        Name = "Enable Ownership Kick",
        Default = false,
        Callback = function(Value)
            if Value then
                if not selectedTarget then
                    Library:Notify({ Title = "Error", Content = "Select target", Duration = 3 })
                    return
                end
                kickActive = true
                if kickTask then task.cancel(kickTask) kickTask = nil end
                kickTask = task.spawn(function() KickFunction(selectedTarget.Name) end)
                Library:Notify({ Title = "Ownership Kick", Content = "Enabled", Duration = 2 })
            else
                kickActive = false
                if kickTask then task.cancel(kickTask) kickTask = nil end
                CleanupTarget(selectedTarget)
                if selectedTarget and selectedTarget.Character then
                    local targetRoot = selectedTarget.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        for _, child in pairs(targetRoot:GetChildren()) do
                            if child:IsA("Attachment") or child:IsA("AlignPosition") or child:IsA("AlignOrientation") then
                                child:Destroy()
                            end
                        end
                        targetRoot.AssemblyLinearVelocity = Vector3.zero
                        targetRoot.AssemblyAngularVelocity = Vector3.zero
                    end
                end
                Library:Notify({ Title = "Ownership Kick", Content = "Disabled", Duration = 2 })
            end
        end
    })

    KickBlock:CreateSlider({
        Name = "Hold Height",
        Min = 5,
        Max = 40,
        Default = 17,
        Rounding = 0,
        Callback = function(Value) holdHeight = Value end
    })

    -- Автообновление списка игроков
    task.spawn(function()
        while true do
            updateList()
            if TargetDropdown then
                pcall(function() TargetDropdown:Refresh(targetNames, true) end)
            end
            task.wait(5)
        end
    end)

    -- Очистка при телепорте
    LocalPlayer.OnTeleport:Connect(function()
        kickActive = false
        if kickTask then task.cancel(kickTask) kickTask = nil end
        CleanupTarget(selectedTarget)
        if fovEnabled then SetFOV(false) fovEnabled = false end
    end)
end

StartMiniScript("Mini Absolute")
