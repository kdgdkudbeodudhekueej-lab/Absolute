    local function createBodyPositions(hrp)
        if bodyPosition then bodyPosition:Destroy() bodyPosition = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
        bodyPosition = Instance.new("BodyPosition")
        bodyPosition.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyPosition.D = 1000
        bodyPosition.P = 10000
        bodyPosition.Position = savedCFrame.Position
        bodyPosition.Parent = hrp
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.D = 1000
        bodyGyro.P = 10000
        bodyGyro.CFrame = savedCFrame
        bodyGyro.Parent = hrp
    end

    local function removeBodyPositions()
        if bodyPosition then bodyPosition:Destroy() bodyPosition = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    end

    local function AntiGrabLoop()
        while antiGrabEnabled do
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hum then
                    if not isHeld.Value then
                        savedCFrame = hrp.CFrame
                        removeBodyPositions()
                        if ragdollActive then
                            ragdollActive = false
                            hum.PlatformStand = false
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                    else
                        if savedCFrame then
                            hrp.CFrame = savedCFrame
                        end
                        if savedCFrame then
                            if not bodyPosition or not bodyPosition.Parent then
                                createBodyPositions(hrp)
                            else
                                bodyPosition.Position = savedCFrame.Position
                                bodyGyro.CFrame = savedCFrame
                            end
                        end
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        pcall(function() struggleEvent:FireServer(LocalPlayer) end)
                        if not ragdollActive then
                            ragdollActive = true
                            pcall(function() ragdollRemote:FireServer(hrp, 0.01) end)
                            task.delay(0.01, function()
