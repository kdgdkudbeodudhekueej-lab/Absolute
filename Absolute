        if setNetOwner then
            pcall(function()
                setNetOwner:FireServer(soundPart, soundPart.CFrame)
            end)
        end
        
        for _, v in pairs(currentPallet:GetChildren()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
                v.CanQuery = false
                v.Transparency = 1
                v.Massless = true
            end
        end
        
        currentPallet.Name = "PalletForRagdoll"
        
        if palletSteppedConn then
            palletSteppedConn:Disconnect()
            palletSteppedConn = nil
        end
        
        local strikePhase = false
        local targetName = target.Name
        local checkInterval = 0.05
        
        palletSteppedConn = RunService.Stepped:Connect(function()
            if not palletActive then
                StopPalletRagdoll()
                return
            end
            
            local currentTarget = Players:FindFirstChild(targetName)
            if not currentTarget then
                StopPalletRagdoll()
                return
            end
            
            local tChar = currentTarget.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            
            if not currentPallet or not currentPallet.Parent then
                DestroyPallet()
                currentPallet = SpawnPallet()
                if currentPallet then
                    local newSoundPart = currentPallet:FindFirstChild("SoundPart")
                    if newSoundPart then
                        soundPart = newSoundPart
                        if setNetOwner then
                            pcall(function()
                                setNetOwner:FireServer(soundPart, soundPart.CFrame)
                            end)
                        end
                        for _, v in pairs(currentPallet:GetChildren()) do
                            if v:IsA("BasePart") then
                                v.CanCollide = false
                                v.CanQuery = false
                                v.Transparency = 1
                                v.Massless = true
                            end
                        end
                        currentPallet.Name = "PalletForRagdoll"
                    end
                end
                return
            end
            
            if tRoot and tHum and tHum.Health > 0 then
                local ragdolledVal = tHum:FindFirstChild("Ragdolled")
                local isRagdolled = ragdolledVal and ragdolledVal.Value or false
                
                if not isRagdolled then
                    strikePhase = not strikePhase
                    if strikePhase then
                        soundPart.CFrame = tRoot.CFrame * CFrame.new(0, 2, 0)
                        soundPart.AssemblyLinearVelocity = Vector3.new(0, -9e5, 0)
                    else
                        soundPart.CFrame = tRoot.CFrame * CFrame.new(0, -1, 0)
                        soundPart.AssemblyLinearVelocity = Vector3.new(0, 9e5, 0)
                    end
                else
                    soundPart.CFrame = CFrame.new(0, 9e9, 0)
                    soundPart.AssemblyLinearVelocity = Vector3.zero
                end
            else
                soundPart.CFrame = CFrame.new(0, 9e9, 0)
                soundPart.AssemblyLinearVelocity = Vector3.zero
            end
        end)
        
        if palletCheckConn then
            palletCheckConn:Disconnect()
            palletCheckConn = nil
        end
        
        palletCheckConn = RunService.Heartbeat:Connect(function()
            if not palletActive then
                StopPalletRagdoll()
                return
            end
            
            if not currentPallet or not currentPallet.Parent then
                local inv = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                if inv then
                    for _, child in pairs(inv:GetChildren()) do
                        if child.Name == "PalletForRagdoll" or child.Name == "PalletLightBrown" then
                            currentPallet = child
                            local newSoundPart = currentPallet:FindFirstChild("SoundPart")
                            if newSoundPart then
                                soundPart = newSoundPart
                                if setNetOwner then
                                    pcall(function()
                                        setNetOwner:FireServer(soundPart, soundPart.CFrame)
                                    end)
                                end
                                for _, v in pairs(currentPallet:GetChildren()) do
                                    if v:IsA("BasePart") then
                                        v.CanCollide = false
                                        v.CanQuery = false
                                        v.Transparency = 1
                                        v.Massless = true
                                    end
                                end
                                currentPallet.Name = "PalletForRagdoll"
                            end
                            break
                        end
                    end
                end
            end
        end)
    end

