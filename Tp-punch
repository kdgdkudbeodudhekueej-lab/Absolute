local CONFIG_FILE = "tppunch_config.json"
local SCRIPT_URL = "https://raw.githubusercontent.com/kdgdkudbeodudhekueej-lab/Absolute/refs/heads/main/Tp-punch"

local defaultConfig = {
    tpPunch = false,
    fastPunch = false,
    autoHop = false,
    autoExecute = false,
    hopTime = 10,
    minPlayers = 6
}

local config = {}
for k, v in pairs(defaultConfig) do config[k] = v end

local function loadConfig()
    if isfile and isfile(CONFIG_FILE) then
        local s, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if s and data then for k, v in pairs(data) do config[k] = v end end
    end
end

local function saveConfig()
    if writefile then
        pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(config)) end)
    end
end

local function deleteConfig()
    if delfile and isfile and isfile(CONFIG_FILE) then
        pcall(function() delfile(CONFIG_FILE) end)
    end
end

