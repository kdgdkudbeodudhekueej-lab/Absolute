-- ===== CONFIG СИСТЕМА =====
local CONFIG_FILE = "tppunch_config.json"

local defaultConfig = {
    tpPunch = false,
    fastPunch = false,
    autoHop = false,
    hopTime = 10,
    minPlayers = 6
}

local config = {}
for k, v in pairs(defaultConfig) do
    config[k] = v
end

local function loadConfig()
    if isfile and isfile(CONFIG_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and data then
            for k, v in pairs(data) do
                config[k] = v
            end
            print("[Config] Загружен: " .. CONFIG_FILE)
            return true
        end
    end
    print("[Config] Файл не найден")
    return false
end

local function saveConfig()
    if writefile then
        pcall(function()
            writefile(CONFIG_FILE, HttpService:JSONEncode(config))
            print("[Config] Сохранён")
        end)
        return true
    end
    return false
end

local function deleteConfig()
    if delfile and isfile and isfile(CONFIG_FILE) then
        pcall(function()
            delfile(CONFIG_FILE)
            print("[Config] Удалён")
        end)
        return true
    end
    return false
end

