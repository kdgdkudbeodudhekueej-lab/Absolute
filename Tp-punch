-- Функция взять punch в руку
local function equipPunch()
    local char = player.Character
    if not char then return end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if string.find(tool.Name:lower(), "punch") or string.find(tool.Name:lower(), "fist") then
                tool.Parent = char
                return true
            end
        end
    end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (string.find(tool.Name:lower(), "punch") or string.find(tool.Name:lower(), "fist")) then
            return true
        end
    end
    return false
end

-- Открепить от текущей цели
local function unweld()
    if currentWeld then
        pcall(function()
            currentWeld:Destroy()
        end)
        currentWeld = nil
    end
    currentTarget = nil
end

-- Прикрепиться намертво сзади цели
local function weldBehind(targetPlayer)
    local myChar = player.Character
    local targetChar = targetPlayer.Character
    if not myChar or not targetChar then return false end
    
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not targetHRP then return false end
    
    -- Если уже прикреплён к этой цели - не трогаем
    if currentTarget == targetPlayer and currentWeld and currentWeld.Parent then
        return true
    end
    
    -- Открепляемся от старой цели
    unweld()
    
    -- Телепортируемся вплотную сзади
    local randomOffset = CFrame.new(
        math.random(-0.3, 0.3),
        0,
        1.2 -- прям впритык, но не внутри
    )
    myHRP.CFrame = targetHRP.CFrame * randomOffset
    
    -- Создаём WELD (намертво прикрепляем)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = myHRP
    weld.Part1 = targetHRP
    weld.Parent = myHRP
    
    currentWeld = weld
    currentTarget = targetPlayer
    return true
end

-- Основной цикл TP Punch
local function farmLoop()
    while isRunning do
        for _, targetPlayer in pairs(Players:GetPlayers()) do
            if targetPlayer ~= player and targetPlayer.Character then
                pcall(function()
                    equipPunch()
                    if weldBehind(targetPlayer) then
                        task.wait(0.1)
                        local char = player.Character
                        local tool = char and char:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                        if punchEvent then
                            punchEvent:FireServer(targetPlayer, targetPlayer.Character)
                        end
                        task.wait(0.4)
                    end
                end)
            end
        end
        task.wait(0.1)
    end
end

local function fastPunchLoop()
    while fastPunchEnabled do
        pcall(function()
            local char = player.Character
            if not char then return end
            equipPunch()
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
            if punchEvent then punchEvent:FireServer() end
        end)
        task.wait(0.05)
    end
end

local function serverHop()
    local servers = {}
    local success, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if success and result and result.data then
        for _, server in pairs(result.data) do
            if server.playing >= config.minPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                table.insert(servers, server.id)
            end
        end
    end
    if #servers > 0 then
        local randomServer = servers[math.random(1, #servers)]
        print("[Auto Hop] Переход на сервер: " .. randomServer)
        TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServer, player)
    else
        print("[Auto Hop] Реконнект...")
        TeleportService:Teleport(game.PlaceId, player)
    end
end

