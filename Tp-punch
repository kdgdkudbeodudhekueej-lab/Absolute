-- Ищем punch event и tool
local punchEvent
for _, event in pairs(ReplicatedStorage.rEvents:GetChildren()) do
    if string.find(event.Name:lower(), "punch") then
        punchEvent = event
        break
    end
end

local isRunning = false
local fastPunchEnabled = false

-- Функция взять punch в руку
local function equipPunch()
    local char = player.Character
    if not char then return end
    
    -- Ищем Punch tool в Backpack
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if string.find(tool.Name:lower(), "punch") or string.find(tool.Name:lower(), "fist") then
                tool.Parent = char
                return true
            end
        end
    end
    
    -- Проверяем если уже в руках
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and (string.find(tool.Name:lower(), "punch") or string.find(tool.Name:lower(), "fist")) then
            return true
        end
    end
    
    return false
end

-- Функция телепорта за спину
local function teleportBehind(targetPlayer)
    local myChar = player.Character
    local targetChar = targetPlayer.Character
    
    if not myChar or not targetChar then return false end
    
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    
    if not myHRP or not targetHRP then return false end
    
    -- Позиция сзади цели со случайным смещением
    local randomOffset = CFrame.new(
        math.random(-2, 2),
        0,
        math.random(2, 4) -- сзади
    )
    
    myHRP.CFrame = targetHRP.CFrame * randomOffset
    return true
end

-- Основной цикл
local function farmLoop()
    while isRunning do
        for _, targetPlayer in pairs(Players:GetPlayers()) do
            if targetPlayer ~= player and targetPlayer.Character then
                pcall(function()
                    -- Берем punch в руку
                    equipPunch()
                    
                    -- Телепортируемся за спину
                    if teleportBehind(targetPlayer) then
                        task.wait(0.05)
                        
                        -- Бьём
                        local char = player.Character
                        local tool = char and char:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        
                        if punchEvent then
                            punchEvent:FireServer(targetPlayer, targetPlayer.Character)
                        end
                        
                        -- Задержка как ты просил (0.5 сек)
                        task.wait(0.5)
                    end
                end)
            end
        end
        task.wait(0.1)
    end
end

-- Fast punch loop
local function fastPunchLoop()
    while fastPunchEnabled do
        pcall(function()
            local char = player.Character
            if not char then return end
            
            equipPunch()
            
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
            
            if punchEvent then
                punchEvent:FireServer()
            end
        end)
        task.wait(0.05)
    end
end

