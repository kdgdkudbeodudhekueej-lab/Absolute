-- ===== ПРАВИЛЬНЫЙ МЕТОД УДАРА =====
local muscleEvent = player:WaitForChild("muscleEvent")

-- Взять punch в руку
local function equipPunch()
    local char = player.Character
    if not char then return end
    
    local punch = char:FindFirstChild("Punch") or player.Backpack:FindFirstChild("Punch")
    if punch and punch.Parent ~= char then
        char.Humanoid:EquipTool(punch)
    end
end

-- НАСТОЯЩИЙ удар через muscleEvent + firetouchinterest (как в Silence)
local function realPunch(targetPlayer)
    local char = player.Character
    if not char then return end
    
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local leftHand = char:FindFirstChild("LeftHand")
    local rightHand = char:FindFirstChild("RightHand")
    
    if not targetHRP or not leftHand or not rightHand then return end
    
    equipPunch()
    
    pcall(function()
        -- firetouchinterest — трогаем цель руками (это и есть удар)
        firetouchinterest(targetHRP, leftHand, 0)
        firetouchinterest(targetHRP, leftHand, 1)
        firetouchinterest(targetHRP, rightHand, 0)
        firetouchinterest(targetHRP, rightHand, 1)
        
        -- muscleEvent punch (как в Silence)
        muscleEvent:FireServer("punch", "leftHand")
        muscleEvent:FireServer("punch", "rightHand")
    end)
end

-- Телепорт ВНУТРЬ игрока
local function teleportInside(targetPlayer)
    local myChar = player.Character
    local targetChar = targetPlayer.Character
    if not myChar or not targetChar then return false end
    
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not targetHRP then return false end
    
    -- ТП прямо ВНУТРЬ (0, 0, 0 = центр игрока)
    myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 0)
    return true
end

-- ===== ПЕРЕМЕННЫЕ =====
local isRunning = config.tpPunch
local fastPunchEnabled = config.fastPunch
local autoHopEnabled = config.autoHop
local autoExecuteEnabled = config.autoExecute

-- Farm loop — ТП внутрь + настоящий удар
local function farmLoop()
    while isRunning do
        local players = Players:GetPlayers()
        for _, targetPlayer in pairs(players) do
            if not isRunning then break end
            if targetPlayer ~= player and targetPlayer.Character then
                pcall(function()
                    -- ТП ВНУТРЬ
                    if teleportInside(targetPlayer) then
                        task.wait(0.05)
                        -- Бьём 3 раза
                        realPunch(targetPlayer)
                        task.wait(0.03)
                        realPunch(targetPlayer)
                        task.wait(0.03)
                        realPunch(targetPlayer)
                        task.wait(0.2)
                    end
                end)
            end
        end
        task.wait(0.05)
    end
end

-- FAST PUNCH — максимально быстро, только удары
local function fastPunchLoop()
    while fastPunchEnabled do
        pcall(function()
            local char = player.Character
            if not char then return end
            
            equipPunch()
            
            -- Быстрые удары через muscleEvent
            muscleEvent:FireServer("punch", "leftHand")
            muscleEvent:FireServer("punch", "rightHand")
            
            -- Tool activate для анимации
            local tool = char:FindFirstChild("Punch")
            if tool then
                tool:Activate()
            end
        end)
        task.wait(0.01) -- ОЧЕНЬ быстро (100 раз в секунду)
    end
end

-- Server Hop
local function serverHop()
    task.spawn(function()
        local servers = {}
        local s, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=50"))
        end)
        if s and result and result.data then
            for _, server in pairs(result.data) do
                if server.playing >= config.minPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    end)
end

