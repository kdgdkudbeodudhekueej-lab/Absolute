local function isAlive(targetPlayer)
    return targetPlayer and targetPlayer.Character
        and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        and targetPlayer.Character:FindFirstChild("Humanoid")
        and targetPlayer.Character.Humanoid.Health > 0
end

local function attackPlayer(targetPlayer)
    local myChar = player.Character
    if not myChar then return end
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetChar:FindFirstChild("Humanoid")
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local leftHand = myChar:FindFirstChild("LeftHand")
    local rightHand = myChar:FindFirstChild("RightHand")
    if not targetHRP or not myHRP or not leftHand or not rightHand or not targetHumanoid then return end

    local targetPos = targetHRP.Position
    local targetLook = targetHRP.CFrame.LookVector
    local behindPos = targetPos - targetLook * distanceOffset
    local abovePos = behindPos + Vector3.new(0, 1, 0)
    myHRP.CFrame = CFrame.lookAt(abovePos, targetPos)

    equipPunch()
    resetAttackTime()
    pcall(function()
        firetouchinterest(targetHRP, leftHand, 0)
        firetouchinterest(targetHRP, leftHand, 1)
        firetouchinterest(targetHRP, rightHand, 0)
        firetouchinterest(targetHRP, rightHand, 1)
    end)
    pcall(function()
        muscleEvent:FireServer("punch", "leftHand")
        muscleEvent:FireServer("punch", "rightHand")
    end)
    local tool = myChar:FindFirstChild("Punch")
    if tool then pcall(function() tool:Activate() end) end
    speedUpAnimations()
end

local function fastPunchLoop()
    while fastPunchEnabled do
        pcall(function()
            local myChar = player.Character
            if not myChar then return end
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            if not myHum or myHum.Health <= 0 then return end

            equipPunch()
            resetAttackTime()

            local leftHand = myChar:FindFirstChild("LeftHand")
            local rightHand = myChar:FindFirstChild("RightHand")
            if leftHand and rightHand then
                pcall(function()
                    firetouchinterest(rightHand, leftHand, 0)
                    firetouchinterest(rightHand, leftHand, 1)
                end)
            end

            pcall(function()
                muscleEvent:FireServer("punch", "leftHand")
                muscleEvent:FireServer("punch", "rightHand")
            end)

            local tool = myChar:FindFirstChild("Punch")
            if tool then pcall(function() tool:Activate() end) end

            if myHum then
                for _, track in pairs(myHum:GetPlayingAnimationTracks()) do
                    pcall(function() track:AdjustSpeed(fpAnimSpeed) end)
                end
            end
        end)
        task.wait(fpDelay)
    end
end

