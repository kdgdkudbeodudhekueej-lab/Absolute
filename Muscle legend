local function createDropdown(y, text, options, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 0, 28)
    label.Position = UDim2.new(0.05, 0, 0, y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.Parent = contentFrame
    
    local dropdown = Instance.new("TextButton")
    dropdown.Size = UDim2.new(0.45, 0, 0, 28)
    dropdown.Position = UDim2.new(0.5, 0, 0, y)
    dropdown.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    dropdown.Text = options[1]
    dropdown.TextColor3 = Color3.fromRGB(255, 255, 255)
    dropdown.TextScaled = true
    dropdown.Font = Enum.Font.Gotham
    dropdown.Parent = contentFrame
    
    local selected = 1
    
    dropdown.MouseButton1Click:Connect(function()
        selected = selected % #options + 1
        dropdown.Text = options[selected]
        callback(options[selected])
    end)
    
    return dropdown
end

