        return
    end
    loopKillEnabled = state
    if state then
        savePosition()
        watchRespawn()
        waitingRespawn = false
        respawnStartTime = 0
        statusLabel.Text = "Status: Killing: " .. selectedPlayer.Name
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        task.spawn(loopKill)
    else
        statusLabel.Text = "Status: OFF"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        respawnTimerLabel.Text = ""
        returnToAnchor()
        anchorCFrame = nil
        waitingRespawn = false
    end
end)

