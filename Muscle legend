local repsPerBatch = 3
local batchDelay = 0.01
local microPause = 0.05
local fasterInstances = 1

local function setMode(mode)
    currentMode = mode
    if mode == "Slower" then
        repsPerBatch = 1
        batchDelay = 0.08
        microPause = 0.3
        fasterInstances = 1
    elseif mode == "Normal" then
        repsPerBatch = 3
        batchDelay = 0.01
        microPause = 0.05
        fasterInstances = 1
    elseif mode == "Faster" then
        repsPerBatch = 3
        batchDelay = 0.01
        microPause = 0.05
        fasterInstances = 4
    elseif mode == "Custom" then
        repsPerBatch = customReps
        batchDelay = customDelay
        microPause = customPause
        fasterInstances = customInstances
    end
end

createDropdown(y, "Speed Mode:", {"Slower", "Normal", "Faster", "Custom"}, function(selected)
    setMode(selected)
end)
