local repCount = 0
local fastThreads = {}

local function fastRepWorker()
    while fastRepRunning do
        for i = 1, repsPerBatch do
            muscleEvent:FireServer("rep")
            repCount = repCount + 1
        end
        task.wait(batchDelay)
        if repCount >= 100 then
            task.wait(microPause)
            repCount = 0
        end
    end
end

local function fastRepLoop()
    for _, thread in ipairs(fastThreads) do
        pcall(function() task.cancel(thread) end)
    end
    fastThreads = {}
    for i = 1, fasterInstances do
        local thread = task.spawn(fastRepWorker)
        table.insert(fastThreads, thread)
    end
end

FastRebTab:AddSwitch("Fast Rep", function(state)
    fastRepRunning = state
    repCount = 0
    if state then 
        fastRepLoop()
    else
        for _, thread in ipairs(fastThreads) do
            pcall(function() task.cancel(thread) end)
        end
        fastThreads = {}
    end
end)

local BossTab = window:AddTab("Boss Kill")

local autoKillBossEnabled = false
local heightOffset = 65

local function findBossPart()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if obj.Name == "BossDamageHitbox" or obj.Name == "Boss" then
                if obj:FindFirstAncestor("BossArena") then
                    return obj
                end
            end
        end
    end
    return nil
end

local function autoKillBossLoop()
    local bodyVel = nil
    local bodyGyro = nil
    local antiGrav = nil

    while autoKillBossEnabled do
        pcall(function()
            local bossPart = findBossPart()
            local myChar = player.Character

            if not bossPart or not myChar then
                if bodyVel then bodyVel:Destroy() bodyVel = nil end
                if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
                if antiGrav then antiGrav:Destroy() antiGrav = nil end
                return
            end

            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            if not myHRP or not myHum then return end

            myHum.PlatformStand = true

            if not antiGrav or not antiGrav.Parent then
                antiGrav = Instance.new("BodyForce")
                antiGrav.Name = "BossAntiGrav"
                antiGrav.Parent = myHRP
            end
            antiGrav.Force = Vector3.new(0, workspace.Gravity * myHRP:GetMass(), 0)

            if not bodyVel or not bodyVel.Parent then
                bodyVel = Instance.new("BodyVelocity")
                bodyVel.Name = "BossBodyVel"
                bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyVel.P = 1250
                bodyVel.Parent = myHRP
            end

            if not bodyGyro or not bodyGyro.Parent then
                bodyGyro = Instance.new("BodyGyro")
                bodyGyro.Name = "BossBodyGyro"
                bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bodyGyro.P = 30000
                bodyGyro.D = 500
                bodyGyro.Parent = myHRP
            end

            local targetPos = bossPart.Position + Vector3.new(0, heightOffset, 0)

            myHRP.CFrame = CFrame.new(targetPos, targetPos - Vector3.new(0, 10, 0))
            bodyVel.Velocity = Vector3.new(0, 0, 0)

            bodyGyro.CFrame = CFrame.lookAt(myHRP.Position, myHRP.Position - Vector3.new(0, 10, 0))

            equipPunch()
            resetAttackTime()

            local leftHand = myChar:FindFirstChild("LeftHand")
            local rightHand = myChar:FindFirstChild("RightHand")
            if leftHand and rightHand then
                pcall(function()
                    firetouchinterest(bossPart, leftHand, 0)
                    firetouchinterest(bossPart, leftHand, 1)
                    firetouchinterest(bossPart, rightHand, 0)
                    firetouchinterest(bossPart, rightHand, 1)
                end)
            end

            pcall(function()
                muscleEvent:FireServer("punch", "leftHand")
                muscleEvent:FireServer("punch", "rightHand")
            end)

            local tool = myChar:FindFirstChild("Punch")
            if tool then pcall(function() tool:Activate() end) end
        end)
        task.wait(0.05)
    end

    if bodyVel then bodyVel:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    if antiGrav then antiGrav:Destroy() end
    local myChar = player.Character
    if myChar then
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if myHum then myHum.PlatformStand = false end
    end
end

