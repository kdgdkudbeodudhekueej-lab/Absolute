local function updateStats()
    local rebirths = rebirthsStat.Value
    local strength = strengthStat.Value
    local durability = durabilityStat.Value
    
    rebirthLabel.Text = string.format("Rebirths: %s (%s) | Gained: %s", formatNumber(rebirths), rebirths, formatNumber(rebirths - rebirthGained))
    strengthLabel.Text = string.format("Strength: %s (%s) | Gained: %s", formatNumber(strength), strength, formatNumber(strength - strengthGained))
    durabilityLabel.Text = string.format("Durability: %s (%s) | Gained: %s", formatNumber(durability), durability, formatNumber(durability - durabilityGained))
end

local function resetStats()
    strengthGained = strengthStat.Value
    durabilityGained = durabilityStat.Value
    updateStats()
end

rebirthsStat:GetPropertyChangedSignal("Value"):Connect(function()
    local rebirths = rebirthsStat.Value
    rebirthLabel.Text = string.format("Rebirths: %s (%s) | Gained: %s", formatNumber(rebirths), rebirths, formatNumber(rebirths - rebirthGained))
    resetStats()
end)

strengthStat:GetPropertyChangedSignal("Value"):Connect(updateStats)
durabilityStat:GetPropertyChangedSignal("Value"):Connect(updateStats)

local function managePets(petName)
    for _, folder in pairs(player.petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in pairs(folder:GetChildren()) do
                ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
            end
        end
    end
    task.wait(0.1)
    for _, pet in pairs(player.petsFolder.Unique:GetChildren()) do
        if pet.Name == petName then
            ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
        end
    end
end

createButton(y, "Equip Swift Samurai", function()
    managePets("Swift Samurai")
end)
y = y + 33

local isRebirthing = false
local fastRepRunning = false
local currentMode = "Normal"

local function doRebirth()
    local target = 5000 + (rebirthsStat.Value * 2550)
    
    while isRebirthing and strengthStat.Value < target do
        local reps = player.MembershipType == Enum.MembershipType.Premium and 8 or 14
        for _ = 1, reps do
            muscleEvent:FireServer("rep")
            task.wait(0.015)
        end
        task.wait(0.05)
    end
    
    if isRebirthing and strengthStat.Value >= target then
        managePets("Tribal Overlord")
        task.wait(0.25)
        local before = rebirthsStat.Value
        repeat
            ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
            task.wait(0.05)
        until rebirthsStat.Value > before or not isRebirthing
    end
end

local function rebirthLoop()
    while isRebirthing do
        managePets("Swift Samurai")
        doRebirth()
        task.wait(0.5)
    end
end

createToggle(y, "Fast Rebirth", function(state)
    isRebirthing = state
    fastRepRunning = state
    if state then
        task.spawn(rebirthLoop)
        task.spawn(fastRepLoop)
    end
end)
y = y + 33

local repsPerBatch = 3
local batchDelay = 0.01
local microPause = 0.05

local function setMode(mode)
    currentMode = mode
    if mode == "Slower" then
        repsPerBatch = 1
        batchDelay = 0.08
        microPause = 0.3
    elseif mode == "Normal" then
        repsPerBatch = 3
        batchDelay = 0.01
        microPause = 0.05
    elseif mode == "Faster" then
        repsPerBatch = 15
        batchDelay = 0.002
        microPause = 0.01
    end
end

createDropdown(y, "Speed:", {"Slower", "Normal", "Faster"}, function(selected)
    setMode(selected)
end)
y = y + 33

local repCount = 0

local function fastRepLoop()
    while fastRepRunning do
        for i = 1, repsPerBatch do
            muscleEvent:FireServer("rep")
            repCount = repCount + 1
        end
        task.wait(batchDelay)
        
        if repCount >= 100 then
            task.wait(microPause)
            repCount = 0
        end
    end
end

createToggle(y, "Fast Rep", function(state)
    fastRepRunning = state
    repCount = 0
    if state then 
        task.spawn(fastRepLoop)
    end
end)
