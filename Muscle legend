task.spawn(function()
    while true do
        task.wait(0.1)
        if waitingRespawn and loopKillEnabled then
            local remaining = RESPAWN_DELAY - (tick() - respawnStartTime)
            if remaining > 0 then
                respawnTimerLabel.Text = string.format("Respawn in: %.2fs", remaining)
            else
                respawnTimerLabel.Text = "Respawning..."
            end
        end
    end
end)

