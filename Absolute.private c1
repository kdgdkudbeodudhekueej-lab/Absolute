local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Absolute_Startup"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

function StartMainScript(titleText)
    local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/fleksmi-bot/Library2/refs/heads/main/Library1.lua"))()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer
    local RS = ReplicatedStorage

    local Window = Library:CreateWindow({
        Title = titleText,
        Theme = "Night",
        ShowWatermark = { Enabled = true, Title = true, User = false, FPS = true, Duration = false, Ping = true, Time= false },
        ToggleKey = Enum.KeyCode.RightShift,
    })

    local mainGui = Window.Parent
    if mainGui then
        local bgFlag = Instance.new("Frame")
        bgFlag.Size = UDim2.new(1, 0, 1, 0)
        bgFlag.BackgroundTransparency = 1
        bgFlag.Parent = mainGui

        local s1 = Instance.new("Frame")
        s1.Size = UDim2.new(1, 0, 0.33, 0)
        s1.Position = UDim2.new(0, 0, 0, 0)
        s1.BackgroundColor3 = Color3.fromRGB(255, 182, 193)
        s1.BackgroundTransparency = 0.15
        s1.BorderSizePixel = 0
        s1.Parent = bgFlag

        local s2 = Instance.new("Frame")
        s2.Size = UDim2.new(1, 0, 0.33, 0)
        s2.Position = UDim2.new(0, 0, 0.33, 0)
        s2.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        s2.BackgroundTransparency = 0.15
        s2.BorderSizePixel = 0
        s2.Parent = bgFlag

        local s3 = Instance.new("Frame")
        s3.Size = UDim2.new(1, 0, 0.34, 0)
        s3.Position = UDim2.new(0, 0, 0.66, 0)
        s3.BackgroundColor3 = Color3.fromRGB(182, 102, 210)
        s3.BackgroundTransparency = 0.15
        s3.BorderSizePixel = 0
        s3.Parent = bgFlag

        bgFlag:MoveToBeginning()

        local function recolor(obj)
            if obj:IsA("TextButton") then
                obj.BackgroundColor3 = (math.random(0,1) == 0) and Color3.fromRGB(255,105,180) or Color3.fromRGB(138,43,226)
                obj.TextColor3 = Color3.fromRGB(255,255,255)
                obj.BorderSizePixel = 1
                obj.BorderColor3 = Color3.fromRGB(255,255,255)
            elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                if obj.BackgroundTransparency < 0.5 then
                    obj.BackgroundTransparency = 0.4
                end
            end
            for _, child in pairs(obj:GetChildren()) do
                recolor(child)
            end
        end
        recolor(Window)
    end

    local MainTab = Window:CreateTab("Main", true)
    local VisualTab = Window:CreateTab("Visual", true)

    local KickBlock = MainTab:CreateBlock({Name = "Ownership Kick", Side = "Left"})
    local TargetBlock = MainTab:CreateBlock({Name = "Target", Side = "Left"})
    local SettingsBlock = MainTab:CreateBlock({Name = "Settings", Side = "Left"})
    local VisualBlock = VisualTab:CreateBlock({Name = "Visual Settings", Side = "Left"})

    -- ========== DELTA TIME ==========
    local deltaTime = 0.016
    RunService.RenderStepped:Connect(function(dt)
        deltaTime = dt
    end)

    -- ========== ПЕРЕМЕННЫЕ ==========
    local selectedTarget = nil
    local kickActive = false
    local kickTask = nil
    local holdHeight = 17

    local fovEnabled = false
    local originalFOV = 70

    local SetNetworkOwner = RS:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
    local DestroyGrabLine = RS:WaitForChild("GrabEvents"):WaitForChild("DestroyGrabLine")

    -- ========== ALIGN ДЛЯ УДЕРЖАНИЯ ==========
    local alignPos = nil
    local alignOrient = nil

    local function cleanupAlign()
        pcall(function()
            if alignPos then 
                alignPos:Destroy() 
                alignPos = nil 
            end
            if alignOrient then 
                alignOrient:Destroy() 
                alignOrient = nil 
            end
        end)
    end

    local function createAlign(targetRoot, targetPos)
        cleanupAlign()
        
        -- Удаляем старые Align, если есть
        for _, v in pairs(targetRoot:GetChildren()) do
            if v:IsA("AlignPosition") or v:IsA("AlignOrientation") then
                v:Destroy()
            end
        end
        
        -- Создаём Attachments
        local att1 = Instance.new("Attachment")
        att1.Parent = targetRoot
        
        local att2 = Instance.new("Attachment")
        att2.Parent = targetRoot
        att2.WorldPosition = targetPos
        att2.WorldOrientation = Vector3.zero
        
        -- AlignPosition
        alignPos = Instance.new("AlignPosition")
        alignPos.Parent = targetRoot
        alignPos.Attachment0 = att1
        alignPos.Attachment1 = att2
        alignPos.MaxForce = 9e9
        alignPos.MaxVelocity = math.huge
        alignPos.Responsiveness = 100
        alignPos.ReactionForceEnabled = false
        
        -- AlignOrientation
        alignOrient = Instance.new("AlignOrientation")
        alignOrient.Parent = targetRoot
        alignOrient.Attachment0 = att1
        alignOrient.Attachment1 = att2
        alignOrient.MaxTorque = 9e9
        alignOrient.MaxAngularVelocity = math.huge
        alignOrient.Responsiveness = 100
        alignOrient.ReactionTorqueEnabled = false
    end

    -- ========== ОСНОВНАЯ ФУНКЦИЯ KICK ==========
    local function OwnershipKickFunction(targetName)
        local target = Players:FindFirstChild(targetName)
        if not target then return end
        
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local savedPos = myRoot.CFrame 
        local dragging = false
        local grabStartTime = 0
        local checkStartTime = 0
        local elapsedTime = 0
        
        while kickActive do
            elapsedTime = elapsedTime + deltaTime
            
            local currentTarget = Players:FindFirstChild(target.Name)
            if not currentTarget or not currentTarget.Parent then 
                cleanupAlign()
                break 
            end
            
            myChar = LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tChar = currentTarget.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")
            
            if tRoot and tHum and tHum.Health > 0 and myRoot then
                if not dragging then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                    cleanupAlign()
                    checkStartTime = 0
                    pcall(function()
                        tHum.PlatformStand = true
                        tHum.Sit = true
                        SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                        SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                        DestroyGrabLine:FireServer(tRoot)
                    end)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    if grabStartTime == 0 then grabStartTime = elapsedTime end
                    if elapsedTime - grabStartTime > 0.35 then
                        dragging = true
                        grabStartTime = 0
                        checkStartTime = elapsedTime
                        local lockPos = savedPos * CFrame.new(0, holdHeight, 0)
                        createAlign(tRoot, lockPos.Position)
                    end
                else
                    myRoot.CFrame = savedPos
                    local lockPos = savedPos * CFrame.new(0, holdHeight, 0)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    
                    if alignPos and alignPos.Parent then
                        -- Обновляем позицию через Attachment1
                        if alignPos.Attachment1 then
                            alignPos.Attachment1.WorldPosition = lockPos.Position
                            alignPos.Attachment1.WorldOrientation = Vector3.zero
                        end
                    else
                        createAlign(tRoot, lockPos.Position)
                    end
                    
                    tHum.PlatformStand = true
                    pcall(function()
                        SetNetworkOwner:FireServer(tRoot, lockPos)
                        SetNetworkOwner:FireServer(tRoot, lockPos)
                        DestroyGrabLine:FireServer(tRoot)
                    end)
                    
                    if checkStartTime > 0 and elapsedTime - checkStartTime > 0.30 then
                        local currentDist = (tRoot.Position - lockPos.Position).Magnitude
                        if currentDist > 10 then
                            dragging = false
                            grabStartTime = 0
                            checkStartTime = 0
                            cleanupAlign()
                            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        else
                            checkStartTime = elapsedTime
                        end
                    end
                end
            else
                dragging = false
                grabStartTime = 0
                checkStartTime = 0
                cleanupAlign()
            end
            RunService.Heartbeat:Wait()
        end
        
        cleanupAlign()
        if myRoot then myRoot.CFrame = savedPos end
        if target and target.Character then
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                pcall(function() DestroyGrabLine:FireServer(tRoot) end)
            end
        end
    end

    -- ========== FOV 120 ==========
    local function SetFOV(value)
        if value then
            originalFOV = Workspace.CurrentCamera.FieldOfView
            Workspace.CurrentCamera.FieldOfView = 120
        else
            Workspace.CurrentCamera.FieldOfView = originalFOV
        end
    end

    -- ========== THIRD PERSON ==========
    local function SetThirdPerson(enabled)
        if enabled then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMaxZoomDistance = 1000
            LocalPlayer.CameraMinZoomDistance = 0.5
        else
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
            LocalPlayer.CameraMaxZoomDistance = 0.5
            LocalPlayer.CameraMinZoomDistance = 0.5
        end
    end

    -- ========== UI ==========
    local targetNames = {}
    local function updateList()
        targetNames = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local displayName = p.DisplayName or p.Name
                table.insert(targetNames, displayName .. " (" .. p.Name .. ")")
            end
        end
    end

    local function getPlayerFromSelection(selection)
        if not selection or selection == "" then return nil end
        local username = selection:match("%((.-)%)")
        if username then
            return Players:FindFirstChild(username)
        end
        return nil
    end

    local TargetDropdown = TargetBlock:CreateDropdown({
        Name = "Select Target",
        Options = targetNames,
        Callback = function(v)
            selectedTarget = getPlayerFromSelection(v)
        end
    })

    TargetBlock:CreateButton({
        Name = "Refresh List",
        Callback = function()
            updateList()
            TargetDropdown:Refresh(targetNames, true)
        end
    })

    SettingsBlock:CreateSlider({
        Name = "Hold Height",
        Min = 5,
        Max = 40,
        Default = 17,
        Rounding = 0,
        Callback = function(Value) holdHeight = Value end
    })

    KickBlock:CreateToggle({
        Name = "Enable Ownership Kick",
        Default = false,
        Callback = function(Value)
            if Value then
                if not selectedTarget then
                    Library:Notify({ Title = "Error", Content = "Select target", Duration = 3 })
                    return
                end
                kickActive = true
                if kickTask then task.cancel(kickTask) kickTask = nil end
                kickTask = task.spawn(function() OwnershipKickFunction(selectedTarget.Name) end)
                Library:Notify({ Title = "Ownership Kick", Content = "Enabled", Duration = 2 })
            else
                kickActive = false
                if kickTask then task.cancel(kickTask) kickTask = nil end
                cleanupAlign()
                if selectedTarget and selectedTarget.Character then
                    local tRoot = selectedTarget.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot then
                        for _, v in pairs(tRoot:GetChildren()) do
                            if v:IsA("AlignPosition") or v:IsA("AlignOrientation") then
                                pcall(function() v:Destroy() end)
                            end
                        end
                        pcall(function()
                            tRoot.AssemblyLinearVelocity = Vector3.zero
                            tRoot.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                end
                Library:Notify({ Title = "Ownership Kick", Content = "Disabled", Duration = 2 })
            end
        end
    })

    VisualBlock:CreateToggle({
        Name = "FOV 120",
        Default = false,
        Callback = function(Value)
            fovEnabled = Value
            SetFOV(Value)
        end
    })

    VisualBlock:CreateToggle({
        Name = "Third Person",
        Default = false,
        Callback = function(Value)
            SetThirdPerson(Value)
        end
    })

    task.spawn(function()
        while true do
            updateList()
            if TargetDropdown then
                pcall(function() TargetDropdown:Refresh(targetNames, true) end)
            end
            task.wait(5)
        end
    end)

    LocalPlayer.OnTeleport:Connect(function()
        kickActive = false
        if kickTask then task.cancel(kickTask) kickTask = nil end
        cleanupAlign()
        if fovEnabled then SetFOV(false) fovEnabled = false end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if fovEnabled then SetFOV(true) end
    end)
end

StartMainScript("Absolute")
