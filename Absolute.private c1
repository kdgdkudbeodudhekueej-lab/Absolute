-- Функции для работы с Grab линиями
local function GetGrabEvents()
    local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
    if not GE then
        GE = ReplicatedStorage:FindFirstChild("Grab") or ReplicatedStorage:FindFirstChild("GrabSystem")
    end
    return GE
end

local function FireCreateGrabLine(targetRoot, position)
    local GE = GetGrabEvents()
    if not GE then return false end
    
    local createGrab = GE:FindFirstChild("CreateGrabLine") or GE:FindFirstChild("CreateGrab")
    if createGrab then
        pcall(function()
            createGrab:FireServer(targetRoot, Vector3.zero, position or targetRoot.Position, false)
        end)
        return true
    end
    return false
end

local function FireDestroyGrabLine(targetRoot)
    local GE = GetGrabEvents()
    if not GE then return false end
    
    local destroyGrab = GE:FindFirstChild("DestroyGrabLine") or GE:FindFirstChild("DestroyGrab") or GE:FindFirstChild("RemoveGrab")
    if destroyGrab then
        pcall(function()
            destroyGrab:FireServer(targetRoot)
        end)
        return true
    end
    return false
end

local function FireSetNetworkOwner(targetRoot, cframe)
    local GE = GetGrabEvents()
    if not GE then return false end
    
    local setOwner = GE:FindFirstChild("SetNetworkOwner") or GE:FindFirstChild("SetOwner")
    if setOwner then
        pcall(function()
            setOwner:FireServer(targetRoot, cframe or targetRoot.CFrame)
        end)
        return true
    end
    return false
end

-- Создание Align констрейнтов
local function createAlignConstraints(targetRoot, targetPos, targetCFrame)
    -- Очищаем старые
    clearAlignConstraints(targetRoot)
    
    local attachments = {}
    
    -- AlignPosition
    local alignPos = Instance.new("AlignPosition")
    local att0 = Instance.new("Attachment")
    local att1 = Instance.new("Attachment")
    
    att0.Parent = targetRoot
    att1.Parent = targetRoot
    
    alignPos.Attachment0 = att0
    alignPos.Attachment1 = att1
    alignPos.Parent = targetRoot
    
    alignPos.MaxForce = alignSettings.PosMaxForce
    alignPos.MaxVelocity = alignSettings.PosMaxVelocity
    alignPos.Responsiveness = alignSettings.PosResponsiveness
    alignPos.Damping = alignSettings.PosDamping
    alignPos.ReactionForce = alignSettings.PosReactionForce
    alignPos.Enabled = true
    alignPos.Position = targetPos
    
    table.insert(attachments, att0)
    table.insert(attachments, att1)
    
    -- AlignOrientation (опционально)
    local alignOrientation = nil
    if alignSettings.UseRotation then
        alignOrientation = Instance.new("AlignOrientation")
        local att2 = Instance.new("Attachment")
        local att3 = Instance.new("Attachment")
        
        att2.Parent = targetRoot
        att3.Parent = targetRoot
        
        alignOrientation.Attachment0 = att2
        alignOrientation.Attachment1 = att3
        alignOrientation.Parent = targetRoot
        
        alignOrientation.MaxTorque = alignSettings.OriMaxTorque
        alignOrientation.MaxAngularVelocity = alignSettings.OriMaxAngularVelocity
        alignOrientation.Responsiveness = alignSettings.OriResponsiveness
        alignOrientation.Damping = alignSettings.OriDamping
        alignOrientation.ReactionForce = alignSettings.OriReactionForce
        alignOrientation.Enabled = true
        alignOrientation.CFrame = targetCFrame or CFrame.new(targetPos)
        
        table.insert(attachments, att2)
        table.insert(attachments, att3)
    end
    
    return alignPos, alignOrientation, attachments
end

-- Очистка Align констрейнтов
local function clearAlignConstraints(rootPart)
    if rootPart then
        for _, child in pairs(rootPart:GetChildren()) do
            if child:IsA("AlignPosition") or child:IsA("AlignOrientation") then
                child:Destroy()
            end
            if child:IsA("Attachment") then
                child:Destroy()
            end
        end
    end
    alignPos = nil
    alignOrientation = nil
    alignAttachments = {}
end

-- Плавное обновление с Delta Time
local function smoothUpdate(current, target, deltaTime)
    local alpha = 1 - math.exp(-alignSettings.SmoothFactor * deltaTime)
    return current:Lerp(target, alpha)
end

-- Основная функция Ownership Kick с Align + Delta Time
local function OwnershipKickFunction(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then 
        Library:Notify({ Title = "Error", Content = "Target not found", Duration = 3 })
        return 
    end
    
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then 
        Library:Notify({ Title = "Error", Content = "Character not found", Duration = 3 })
        return 
    end

    local savedPos = myRoot.CFrame
    local targetRoot = nil
    local targetHumanoid = nil
    local isGrabbed = false
    local grabCount = 0
    local lastGrabTime = 0
    local lastUpdateTime = tick()
    local deltaTime = 0
    
    -- Текущая позиция для сглаживания
    local currentTargetPos = savedPos * CFrame.new(0, alignSettings.HoldHeight, 0)
    
    -- Уведомление о начале
    Library:Notify({ 
        Title = "Ownership Kick", 
        Content = "Starting on: " .. target.Name, 
        Duration = 2 
    })
    
    while kickActive do
        -- Вычисляем Delta Time
        local currentTime = tick()
        deltaTime = currentTime - lastUpdateTime
        lastUpdateTime = currentTime
        
        -- Ограничиваем Delta Time
        if deltaTime > 0.1 then deltaTime = 0.1 end
        if deltaTime < 0.001 then deltaTime = 0.001 end
        
        -- Проверяем существование цели
        local currentTarget = Players:FindFirstChild(target.Name)
        if not currentTarget or not currentTarget.Parent then 
            break 
        end
        
        -- Обновляем персонажей
        myChar = LocalPlayer.Character
        myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then break end
        
        local tChar = currentTarget.Character
        targetRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        targetHumanoid = tChar and tChar:FindFirstChild("Humanoid")
        
        if not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
            isGrabbed = false
            task.wait(0.1)
            continue
        end
        
        if not isGrabbed then
            -- ФАЗА 1: Захват цели
            isGrabbed = true
            
            -- Телепортируемся к цели
            local teleportPos = targetRoot.CFrame * CFrame.new(0, 0, alignSettings.TeleportDistance)
            myRoot.CFrame = teleportPos
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            
            -- Устанавливаем NetworkOwner
            FireSetNetworkOwner(targetRoot, targetRoot.CFrame)
            
            -- Создаем граб линии
            if alignSettings.UseGrabLine then
                for i = 1, 3 do
                    FireCreateGrabLine(targetRoot)
                end
            end
            
            -- Создаем Align констрейнты
            local lockPos = savedPos * CFrame.new(0, alignSettings.HoldHeight, 0)
            currentTargetPos = lockPos
            alignPos, alignOrientation, _ = createAlignConstraints(
                targetRoot, 
                lockPos.Position,
                lockPos
            )
            
            -- Устанавливаем PlatformStand
            targetHumanoid.PlatformStand = true
            
            Library:Notify({ 
                Title = "Ownership Kick", 
                Content = "Target grabbed! (Align)", 
                Duration = 1 
            })
            
            grabCount = 0
            
        else
            -- ФАЗА 2: Удержание с Align + Delta Time
            local lockPos = savedPos * CFrame.new(0, alignSettings.HoldHeight, 0)
            
            -- Плавное обновление позиции с Delta Time
            currentTargetPos = smoothUpdate(currentTargetPos, lockPos, deltaTime)
            
            -- Обновляем AlignPosition
            if alignPos and alignPos.Parent then
                alignPos.Position = currentTargetPos.Position
                
                -- Динамическая настройка силы в зависимости от расстояния
                local distance = (targetRoot.Position - currentTargetPos.Position).Magnitude
                if distance > 10 then
                    alignPos.MaxForce = alignSettings.PosMaxForce * 2
                else
                    alignPos.MaxForce = alignSettings.PosMaxForce
                end
            end
            
            -- Обновляем AlignOrientation
            if alignOrientation and alignOrientation.Parent and alignSettings.UseRotation then
                alignOrientation.CFrame = currentTargetPos
            end
            
            -- Телепортируем игрока обратно
            myRoot.CFrame = savedPos
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            
            -- Сбрасываем скорость цели
            targetRoot.AssemblyLinearVelocity = Vector3.zero
            targetRoot.AssemblyAngularVelocity = Vector3.zero
            
            -- СПАМ ГРАБ ЛИНИЙ с учетом Delta Time
            if alignSettings.UseGrabLine then
                grabCount = grabCount + 1
                local currentTime = tick()
                
                -- Спамим с заданной скоростью
                if currentTime - lastGrabTime >= alignSettings.Speed then
                    -- Создаем несколько граб линий
                    for i = 1, alignSettings.GrabSpamCount do
                        FireCreateGrabLine(targetRoot, currentTargetPos)
                    end
                    
                    -- Удаляем с задержкой
                    task.wait(alignSettings.DestroyDelay)
                    
                    -- Удаляем граб линии
                    for i = 1, alignSettings.GrabSpamCount do
                        FireDestroyGrabLine(targetRoot)
                    end
                    
                    -- Обновляем NetworkOwner
                    FireSetNetworkOwner(targetRoot, currentTargetPos)
                    
                    lastGrabTime = currentTime
                end
            end
            
            -- Проверка расстояния для перезахвата
            local distance = (targetRoot.Position - currentTargetPos.Position).Magnitude
            if distance > 15 then
                isGrabbed = false
                clearAlignConstraints(targetRoot)
                if alignSettings.UseGrabLine then
                    FireDestroyGrabLine(targetRoot)
                end
                Library:Notify({ 
                    Title = "Ownership Kick", 
                    Content = "Re-grabbing target...", 
                    Duration = 1 
                })
            end
        end
        
        -- Ожидание с учетом скорости
        task.wait(alignSettings.Speed)
    end
    
    -- Очистка при завершении
    if target and target.Character then
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            clearAlignConstraints(tRoot)
            if alignSettings.UseGrabLine then
                FireDestroyGrabLine(tRoot)
                FireDestroyGrabLine(tRoot)
            end
            local hum = target.Character:FindFirstChild("Humanoid")
            if hum then
                hum.PlatformStand = false
            end
        end
    end
    
    if myRoot then
        myRoot.CFrame = savedPos
    end
    
    kickActive = false
    isGrabbed = false
    
    Library:Notify({ 
        Title = "Ownership Kick", 
        Content = "Stopped", 
        Duration = 2 
    })
end

-- Toggle для активации кика
KickBlock:CreateToggle({
