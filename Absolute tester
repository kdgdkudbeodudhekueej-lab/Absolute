            else
                for part, data in pairs(pclespAdornments) do
                    if data.box then data.box:Destroy() end
                    if data.outline then data.outline:Destroy() end
                end
                pclespAdornments = {}
            end
        end
    })

    RunService.Heartbeat:Connect(function()
        if not pclespEnabled then return end
        
        local currentTime = tick()
        
        if currentTime - lastScan >= scanInterval then
            lastScan = currentTime
            ScanForESPParts()
            CleanupESP()
        end
        
        for part, data in pairs(pclespAdornments) do
            UpdateESP(part)
        end
    end)

