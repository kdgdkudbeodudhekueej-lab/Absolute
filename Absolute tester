    local function gucciRemove()
        local f = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if f then
            for _, v in ipairs(f:GetChildren()) do
                if v.Name == "guchi" or v.Name == "CreatureBlobman" then
                    gucciDestroyToy(v)
                end
            end
        end
        local c = LocalPlayer.Character
        if c then
            local _, r, h = gucciGetHRH(c)
            if r and h and h.Health > 0 then
                r.Anchored = false
                r.Velocity = Vector3.zero
                h.Sit = true
                task.wait(0.05)
                h.Sit = false
            end
        end
    end

    local function gucciApply()
        gucciRemove()
        local c = LocalPlayer.Character
        if not c then return end
        local _, r, h = gucciGetHRH(c)
        if not r or not h or h.Health <= 0 then return end
        if not h:FindFirstChild("Ragdolled") or h.Ragdolled.Value then return end

        local b = gucciNewToy("CreatureBlobman", CFrame.new(0, 1000000, 20))
        if not b then return end
        b.Name = "guchi"

        local s = b:WaitForChild("VehicleSeat", 1)
        local hd = b:WaitForChild("Head", 1)
        local hr = b:WaitForChild("HumanoidRootPart", 1)
        if not (s and hd and hr) then return end

        s.Anchored = true
        local f = true

        task.spawn(function()
            while f and s and s.Parent and r and h and h.Health > 0 do
                r.Anchored = true
                ragdollRemote:FireServer(r, 0)
                for _, x in ipairs(c:GetChildren()) do
                    if x.Name == "LocalCreatureControl" then x.Enabled = false end
                end
                task.wait()
            end
        end)

        while h and h.Health > 0 and s and s.Parent and not s.Occupant do
            s:Sit(h)
            task.wait()
        end

        if h and h.Health > 0 and s and s.Parent and s.Occupant == h then
            h.Sit = false
        end

        local t = tick()
        while true do
            gucciOwner(hr)
            task.wait()
            if not hd or not hd.Parent or (hd:FindFirstChild("PartOwner") and hd.PartOwner.Value == LocalPlayer.Name) or not h or h.Health <= 0 or tick() - t > 1 then
                break
            end
        end

        f = false
        if r and h.Health > 0 then
            r.Velocity = Vector3.zero
            r.Anchored = false
        end
        if s and s.Parent then return s end
    end

