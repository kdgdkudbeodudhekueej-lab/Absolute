    local function agV2SetRagdoll(char, enabled)
        for _, c in pairs(char:GetChildren()) do
            if c:IsA("BasePart") and c:FindFirstChild("BallSocketConstraint") and c.Name ~= "Head" then
                c.BallSocketConstraint.Enabled = enabled
