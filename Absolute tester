    local function AntiGrabLoop()
        while antiGrabEnabled do
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hum then
                    if not isHeld.Value then
                        savedCFrame = hrp.CFrame
                        removeBodyPositions()
                        if ragdollActive then
                            ragdollActive = false
                            hum.PlatformStand = false
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                    else
                        if savedCFrame then
                            hrp.CFrame = savedCFrame
                        end
                        if savedCFrame then
                            if not bodyPosition or not bodyPosition.Parent then
                                createBodyPositions(hrp)
                            else
                                bodyPosition.Position = savedCFrame.Position
                                bodyGyro.CFrame = savedCFrame
                            end
                        end
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        pcall(function() struggleEvent:FireServer(LocalPlayer) end)
                        if antiGrabMode == "Ragdoll" then
                            if not ragdollActive then
                                ragdollActive = true
                                pcall(function() ragdollRemote:FireServer(hrp, 0.01) end)
                                task.delay(0.01, function()
                                    if ragdollActive then
                                        ragdollActive = false
                                        if hum then
                                            hum.PlatformStand = false
                                            hum:ChangeState(Enum.HumanoidStateType.Running)
                                        end
                                    end
                                end)
                            end
                            if hum then
                                hum.Sit = false
                                hum.PlatformStand = false
                                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                                hum:ChangeState(Enum.HumanoidStateType.Running)
                                hum.AutoRotate = true
                            end
                        else
                            if hum then
                                hum.Sit = false
                                hum.PlatformStand = false
                                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                                hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
                                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                                hum:ChangeState(Enum.HumanoidStateType.Running)
                                hum.AutoRotate = true
                                hum.WalkSpeed = 0
                                hum.JumpPower = 0
                                hum.JumpHeight = 0
                            end
                        end
                        local head = char:FindFirstChild("Head")
                        if head then
