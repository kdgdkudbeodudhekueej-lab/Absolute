local sessionStart = os.clock()

local function formatTime(seconds)
    seconds = math.floor(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if h > 0 then
        return string.format("%02d:%02d:%02d", h, m, s)
    end
    return string.format("%02d:%02d", m, s)
end

task.spawn(function()
    local frames = 0
    local lastTime = os.clock()
    local ping = 0

    while MainFrame and MainFrame.Parent do
        RunService.RenderStepped:Wait()
        frames = frames + 1
        local now = os.clock()

        if now - lastTime >= 0.2 then
            local fps = math.round(frames / (now - lastTime))
            frames = 0
            lastTime = now

            pcall(function()
                ping = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)

            local uptime = formatTime(now - sessionStart)
            Label.Text = string.format("%s %s  |  %s  |  %d fps  |  %d ms", SCRIPT_NAME, SCRIPT_VERSION, uptime, fps, ping)
        end
    end
end)

