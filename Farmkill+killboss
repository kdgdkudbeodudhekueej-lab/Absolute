local repCount = 0
local fastThreads = {}

local function fastRepWorker()
    while fastRepRunning do
        for i = 1, repsPerBatch do
            muscleEvent:FireServer("rep")
            repCount = repCount + 1
        end
        task.wait(batchDelay)
        if repCount >= 100 then
            task.wait(microPause)
            repCount = 0
        end
    end
end

local function fastRepLoop()
    for _, thread in ipairs(fastThreads) do
        pcall(function() task.cancel(thread) end)
    end
    fastThreads = {}
    for i = 1, fasterInstances do
        local thread = task.spawn(fastRepWorker)
        table.insert(fastThreads, thread)
    end
end

createToggle(rbContent, y, "Fast Rep", function(state)
    fastRepRunning = state
    repCount = 0
    if state then 
        fastRepLoop()
    else
        for _, thread in ipairs(fastThreads) do
            pcall(function() task.cancel(thread) end)
        end
        fastThreads = {}
    end
end)

