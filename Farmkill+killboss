local anchorCFrame = nil
local waitingRespawn = false
local RESPAWN_DELAY = 4.66
local respawnStartTime = 0
local fastPunchEnabled = false
local fastAttackEnabled = false
local spectateEnabled = false
local selectedPlayer = nil
local dropdownOpen = false
local killAllEnabled = false
local cameraLockEnabled = false
local cameraAnchorPart = nil
local killAllThread = nil

local function savePosition()
    local myChar = player.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if myHRP then anchorCFrame = myHRP.CFrame end
end

local function returnToAnchor()
    if not anchorCFrame then return end
    local myChar = player.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if myHRP then myHRP.CFrame = anchorCFrame end
end

local function startCameraLock()
    if cameraAnchorPart then
        cameraAnchorPart:Destroy()
        cameraAnchorPart = nil
    end
    local myChar = player.Character
    if not myChar then return end
    local anchorPart = Instance.new("Part")
    anchorPart.Name = "CameraAnchorPart"
    anchorPart.Anchored = true
    anchorPart.CanCollide = false
    anchorPart.Transparency = 1
    anchorPart.Size = Vector3.new(1, 2, 1)
    anchorPart.CFrame = anchorCFrame
    anchorPart.Parent = workspace
    local anchorHumanoid = Instance.new("Humanoid")
    anchorHumanoid.Parent = anchorPart
    camera.CameraSubject = anchorHumanoid
    cameraAnchorPart = anchorPart
end

local function stopCameraLock()
    if cameraAnchorPart then
        cameraAnchorPart:Destroy()
        cameraAnchorPart = nil
    end
    local myChar = player.Character
    if myChar then
        local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
        if myHumanoid then camera.CameraSubject = myHumanoid end
    end
end

local function isAlive(targetPlayer)
    return targetPlayer and targetPlayer.Character 
        and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        and targetPlayer.Character:FindFirstChild("Humanoid")
        and targetPlayer.Character.Humanoid.Health > 0
end

local function attackPlayer(targetPlayer)
    local myChar = player.Character
    if not myChar then return end
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetChar:FindFirstChild("Humanoid")
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local leftHand = myChar:FindFirstChild("LeftHand")
    local rightHand = myChar:FindFirstChild("RightHand")
    if not targetHRP or not myHRP or not leftHand or not rightHand or not targetHumanoid then return end
    myHRP.CFrame = targetHRP.CFrame
    equipPunch()
    resetAttackTime()
    pcall(function()
        firetouchinterest(targetHRP, leftHand, 0)
        firetouchinterest(targetHRP, leftHand, 1)
        firetouchinterest(targetHRP, rightHand, 0)
        firetouchinterest(targetHRP, rightHand, 1)
    end)
    pcall(function()
        muscleEvent:FireServer("punch", "leftHand")
        muscleEvent:FireServer("punch", "rightHand")
    end)
    local tool = myChar:FindFirstChild("Punch")
    if tool then pcall(function() tool:Activate() end) end
    speedUpAnimations()
end

local function fastPunchLoop()
    while fastPunchEnabled do
        pcall(function()
            local char = player.Character
            if not char then return end
            equipPunch()
            resetAttackTime()
            muscleEvent:FireServer("punch", "leftHand")
            muscleEvent:FireServer("punch", "rightHand")
            local tool = char:FindFirstChild("Punch")
            if tool then tool:Activate() end
            speedUpAnimations()
        end)
        task.wait(0.15)
    end
end

local function fastAttackLoop()
    while fastAttackEnabled do
        pcall(function()
            local myChar = player.Character
            if not myChar then return end
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            local leftHand = myChar:FindFirstChild("LeftHand")
            local rightHand = myChar:FindFirstChild("RightHand")
            if not myHRP or not leftHand or not rightHand then return end
            equipPunch()
            resetAttackTime()
            for _, targetPlayer in pairs(Players:GetPlayers()) do
                if targetPlayer ~= player and isAlive(targetPlayer) then
                    local targetChar = targetPlayer.Character
                    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        pcall(function()
                            firetouchinterest(targetHRP, leftHand, 0)
                            firetouchinterest(targetHRP, leftHand, 1)
                            firetouchinterest(targetHRP, rightHand, 0)
                            firetouchinterest(targetHRP, rightHand, 1)
                        end)
                    end
                end
            end
            pcall(function()
                muscleEvent:FireServer("punch", "leftHand")
                muscleEvent:FireServer("punch", "rightHand")
            end)
            local tool = myChar:FindFirstChild("Punch")
            if tool then tool:Activate() end
            speedUpAnimations()
        end)
        task.wait(0.15)
    end
end

local function killAllLoop()
    while killAllEnabled do
        local targetFound = false
        for _, targetPlayer in pairs(Players:GetPlayers()) do
            if not killAllEnabled then break end
            if targetPlayer ~= player and isAlive(targetPlayer) then
                targetFound = true
                local myChar = player.Character
                if not myChar then break end
                local targetChar = targetPlayer.Character
                if not targetChar then continue end
                local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                local leftHand = myChar:FindFirstChild("LeftHand")
                local rightHand = myChar:FindFirstChild("RightHand")
                if myHRP and leftHand and rightHand then
                    equipPunch()
                    task.wait(0.15)
                    for _ = 1, 3 do
                        if not killAllEnabled then break end
                        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
                        if not targetHRP then break end
                        myHRP.CFrame = targetHRP.CFrame
                        resetAttackTime()
                        local tool = myChar:FindFirstChild("Punch")
                        if tool then pcall(function() tool:Activate() end) end
                        pcall(function()
                            firetouchinterest(targetHRP, leftHand, 0)
                            firetouchinterest(targetHRP, leftHand, 1)
                            firetouchinterest(targetHRP, rightHand, 0)
                            firetouchinterest(targetHRP, rightHand, 1)
                        end)
                        pcall(function()
                            muscleEvent:FireServer("punch", "leftHand")
                            muscleEvent:FireServer("punch", "rightHand")
                        end)
                        speedUpAnimations()
                        task.wait(0.2)
                    end
                end
            end
        end
        if not killAllEnabled then break end
        if not targetFound then
            returnToAnchor()
            task.wait(0.5)
        else
            returnToAnchor()
            task.wait(0.3)
        end
    end
    returnToAnchor()
end

