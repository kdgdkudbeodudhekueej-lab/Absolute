        rebirthProgressLabel.Text = "До ребита: ГОТОВ!"
        rebirthProgressLabel.TextColor3 = Color3.fromRGB(50, 200, 50)
    else
        rebirthProgressLabel.Text = string.format("До ребита: %s (%s / %s)", formatNumber(needed), formatNumber(strengthStat.Value), formatNumber(target))
        rebirthProgressLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
