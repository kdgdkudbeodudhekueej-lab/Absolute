local repsPerBatch = 3
local batchDelay = 0.01
local microPause = 0.05
local fasterInstances = 1

local function setMode(mode)
    if mode == "Slower" then
        repsPerBatch = 1
        batchDelay = 0.08
        microPause = 0.3
        fasterInstances = 1
    elseif mode == "Normal" then
        repsPerBatch = 3
        batchDelay = 0.01
        microPause = 0.05
        fasterInstances = 1
    elseif mode == "Faster" then
        repsPerBatch = 3
        batchDelay = 0.01
        microPause = 0.05
        fasterInstances = 4
    elseif mode == "Very Faster" then
        repsPerBatch = 5
        batchDelay = 0.005
        microPause = 0.02
        fasterInstances = 6
    end
end

