local function equipPunch()
    local char = player.Character
    if not char then return end
    local punch = char:FindFirstChild("Punch") or player.Backpack:FindFirstChild("Punch")
    if punch and punch.Parent ~= char then
        char.Humanoid:EquipTool(punch)
    end
end

local function speedUpAnimations()
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
            pcall(function()
                track:AdjustSpeed(3)
            end)
        end
    end
end

local function resetAttackTime()
    local char = player.Character
    if not char then return end
    local punch = char:FindFirstChild("Punch")
    if punch then
        local attackTime = punch:FindFirstChild("attackTime")
        if attackTime then
            attackTime.Value = 0
        end
    end
end

local function isBoss(model)
    if not model or not model.Name then return false end
    return BOSS_NAMES[model.Name] == true
end

local function findBoss()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isBoss(obj) then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if humanoid and hrp and humanoid.Health > 0 then
                return obj, hrp
            end
        end
    end
    return nil, nil
end

local function attackBoss(bossHRP)
    local myChar = player.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local leftHand = myChar:FindFirstChild("LeftHand")
    local rightHand = myChar:FindFirstChild("RightHand")
    if not myHRP or not leftHand or not rightHand then return end
    local abovePos = bossHRP.Position + Vector3.new(0, heightOffset, 0)
    myHRP.CFrame = CFrame.new(abovePos, bossHRP.Position)
    equipPunch()
    resetAttackTime()
    pcall(function()
        firetouchinterest(bossHRP, leftHand, 0)
        firetouchinterest(bossHRP, leftHand, 1)
        firetouchinterest(bossHRP, rightHand, 0)
        firetouchinterest(bossHRP, rightHand, 1)
    end)
    pcall(function()
        muscleEvent:FireServer("punch", "leftHand")
        muscleEvent:FireServer("punch", "rightHand")
    end)
    local tool = myChar:FindFirstChild("Punch")
    if tool then
        pcall(function() tool:Activate() end)
    end
    speedUpAnimations()
end

local function autoKillBossLoop()
    while autoKillBossEnabled do
        pcall(function()
            local bossModel, bossHRP = findBoss()
            if bossModel and bossHRP then
                attackBoss(bossHRP)
            end
        end)
        task.wait(0.1)
    end
end

