local spectateConnection = nil

local function updateSpectateTarget()
    if spectateConnection then
        spectateConnection:Disconnect()
        spectateConnection = nil
    end
    if not spectateEnabled or not selectedPlayer then return end
    if selectedPlayer.Character then
        local humanoid = selectedPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            camera.CameraSubject = humanoid
        end
    end
    spectateConnection = selectedPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.3)
        if spectateEnabled then
            local humanoid = newChar:FindFirstChildOfClass("Humanoid")
            if humanoid then
                camera.CameraSubject = humanoid
            end
        end
    end)
end

local function stopSpectate()
    if spectateConnection then
        spectateConnection:Disconnect()
        spectateConnection = nil
    end
    local myChar = player.Character
    if myChar then
        local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
        if myHumanoid then
            camera.CameraSubject = myHumanoid
        end
    end
end

local loopKillEnabled = false
local statusLabel
local respawnTimerLabel

local function watchRespawn()
    if not selectedPlayer then return end
    selectedPlayer.CharacterAdded:Connect(function()
        if loopKillEnabled then
            respawnStartTime = tick()
            waitingRespawn = true
        end
    end)
end

local function loopKill()
    while loopKillEnabled do
        if selectedPlayer then
            if waitingRespawn then
                local elapsed = tick() - respawnStartTime
                local remaining = RESPAWN_DELAY - elapsed
                if remaining <= 0 and isAlive(selectedPlayer) then
                    waitingRespawn = false
                    if statusLabel then
                        statusLabel.Text = "Killing: " .. selectedPlayer.Name
                        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                    end
                    if respawnTimerLabel then
                        respawnTimerLabel.Text = ""
                    end
                end
            else
                if isAlive(selectedPlayer) then
                    pcall(function()
                        attackPlayer(selectedPlayer)
                    end)
                else
                    waitingRespawn = true
                    respawnStartTime = tick()
                    returnToAnchor()
                    if statusLabel then
                        statusLabel.Text = "Wait respawn..."
                        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                    end
                end
            end
        end
        task.wait(0.01)
    end
end

