local function equipPunch()
    local char = player.Character
    if not char then return end
    local punch = char:FindFirstChild("Punch") or player.Backpack:FindFirstChild("Punch")
    if punch and punch.Parent ~= char then
        char.Humanoid:EquipTool(punch)
    end
end

local function speedUpAnimations()
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
            pcall(function()
                track:AdjustSpeed(3)
            end)
        end
    end
end

local function resetAttackTime()
    local char = player.Character
    if not char then return end
    local punch = char:FindFirstChild("Punch")
    if punch then
        local attackTime = punch:FindFirstChild("attackTime")
        if attackTime then attackTime.Value = 0 end
    end
end

local function findBossPart()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if obj.Name == "BossDamageHitbox" or obj.Name == "Boss" then
                if obj:FindFirstAncestor("BossArena") then
                    return obj
                end
            end
        end
    end
    return nil
end

local function autoKillBossLoop()
    while autoKillBossEnabled do
        pcall(function()
            local bossPart = findBossPart()
            if not bossPart then return end
            local myChar = player.Character
            if not myChar then return end
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end
            local targetPos = bossPart.Position + Vector3.new(0, heightOffset, 0)
            myHRP.CFrame = CFrame.new(targetPos, bossPart.Position)
            equipPunch()
            resetAttackTime()
            local leftHand = myChar:FindFirstChild("LeftHand")
            local rightHand = myChar:FindFirstChild("RightHand")
            if leftHand and rightHand then
                pcall(function()
                    firetouchinterest(bossPart, leftHand, 0)
                    firetouchinterest(bossPart, leftHand, 1)
                    firetouchinterest(bossPart, rightHand, 0)
                    firetouchinterest(bossPart, rightHand, 1)
                end)
            end
            pcall(function()
                muscleEvent:FireServer("punch", "leftHand")
                muscleEvent:FireServer("punch", "rightHand")
            end)
            local tool = myChar:FindFirstChild("Punch")
            if tool then pcall(function() tool:Activate() end) end
        end)
        task.wait(0.05)
    end
end

