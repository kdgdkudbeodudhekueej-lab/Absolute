                if pet.Name == "Rare Boss Pet" and bossEquipped < 2 then
                    ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
                    bossEquipped = bossEquipped + 1
                    task.wait(0.05)
                end
            end
        end
    end
end

