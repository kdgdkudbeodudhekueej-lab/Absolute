    strengthLabel.Text = string.format("Strength: %s | Gained: %s", formatNumber(strengthStat.Value), formatNumber(strengthStat.Value - strengthGained))
    durabilityLabel.Text = string.format("Durability: %s | Gained: %s", formatNumber(durabilityStat.Value), formatNumber(durabilityStat.Value - durabilityGained))

